---
import SiteNav from './SiteNav.astro';
import ProjectArtwork from './ProjectArtwork.astro';
import { projectGroups, type Locale } from '../data/portfolio';
import type { repositoryProjects } from '../data/repository-projects';
import { sitePath } from '../lib/paths';
import '../styles/home.css';
import '../styles/project-detail.css';

interface Props { project: typeof repositoryProjects[number]; locale: Locale; }
const { project, locale } = Astro.props;
const en = locale === 'en';
const detail = project.caseStudy;
const home = sitePath(en ? '/en' : '/');
const pathname = `${en ? '/en' : ''}/projects/${project.slug}`;
const group = projectGroups.find(group => group.kind === project.group)!;
const chapters = en
  ? [['Context', 'context'], ['Workflow', 'workflow'], ['Implementation', 'implementation'], ['Boundaries', 'boundaries'], ['Source', 'source']]
  : [['背景', 'context'], ['流程', 'workflow'], ['实现', 'implementation'], ['边界', 'boundaries'], ['源码', 'source']];
---
<!doctype html>
<html lang={en ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f5" />
    <meta name="description" content={project.summary[locale]} />
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <title>{project.name[locale]} · {en ? 'Yu Yang' : '于洋项目档案'}</title>
  </head>
  <body>
    <a class="skip-link" href="#detail-content">{en ? 'Skip to project' : '跳至项目正文'}</a>
    <SiteNav locale={locale} pathname={pathname} detail />
    <main id="detail-content" class="project-detail repository-project">
      <section class="detail-hero" aria-labelledby="project-title">
        <div class="detail-hero-copy">
          <p class="detail-index">{group.label[locale]}</p>
          <h1 id="project-title">{project.shortName[locale]}</h1>
          <p class="detail-lede">{project.summary[locale]}</p>
          <dl class="project-facts">
            <div><dt>{en ? 'Project type' : '项目类型'}</dt><dd>{project.ownership[locale]}</dd></div>
            <div><dt>{en ? 'Implementation scope' : '实现范围'}</dt><dd>{project.role[locale]}</dd></div>
            <div><dt>{en ? 'Technologies' : '技术重点'}</dt><dd>{project.tags.join(' · ')}</dd></div>
          </dl>
          <div class="detail-actions">
            <a class="detail-primary" href={project.source} target="_blank" rel="noopener noreferrer">{en ? 'View on GitHub' : '查看 GitHub 仓库'} ↗</a>
            <a class="detail-quiet" href={`${home}#projects`}>{en ? 'All projects' : '返回作品集'} ↗</a>
          </div>
        </div>
        <figure class="repository-artwork">
          <ProjectArtwork kind={project.id} />
          <figcaption>{en ? 'Project concept illustration' : '项目概念示意'}</figcaption>
        </figure>
      </section>
      <div class="detail-body">
        <aside class="chapter-rail" aria-label={en ? 'On this page' : '页内章节'}>
          <p>{en ? 'Reading path' : '阅读路径'}</p>
          <ol>{chapters.map(([label, id]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
        </aside>
        <article class="detail-article">
          <section id="context" class="detail-section">
            <h2>{en ? 'What this project addresses' : '项目解决什么问题'}</h2>
            <p>{detail.context[locale]}</p>
          </section>
          <section id="workflow" class="detail-section">
            <h2>{en ? 'From input to output' : '从输入到输出'}</h2>
            <ol class="repository-workflow">
              {detail.workflow[locale].map(([title, description], index) => <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{description}</p></div></li>)}
            </ol>
          </section>
          <section id="implementation" class="detail-section">
            <h2>{en ? 'Implementation highlights' : '关键工程实现'}</h2>
            <ul class="reliability-list">{project.proofs[locale].map(([title, proof]) => <li><strong>{title}</strong><span>{proof}</span></li>)}</ul>
          </section>
          <section id="boundaries" class="detail-section">
            <h2>{en ? 'Scope and current boundaries' : '范围与当前边界'}</h2>
            <ul class="repository-boundaries">{detail.boundaries[locale].map(boundary => <li>{boundary}</li>)}</ul>
            {detail.upstream && <a class="repository-upstream" href={detail.upstream} target="_blank" rel="noopener noreferrer">{en ? 'Original project: PullMyBoots/X-MinimaxH3' : '原始项目：PullMyBoots/X-MinimaxH3'} ↗</a>}
          </section>
          <section id="source" class="detail-section">
            <h2>{en ? 'Explore the source' : '沿着源码继续阅读'}</h2>
            <ul class="repository-sources">{detail.references.map(reference => <li><a href={`${project.source}/blob/main/${reference.path}`} target="_blank" rel="noopener noreferrer"><strong>{reference.label[locale]} ↗</strong><code>{reference.path}</code></a></li>)}</ul>
            <div class="detail-end-actions"><a href={`${home}#projects`}>{en ? 'Back to all projects' : '返回全部作品'} ↑</a><a href={`${home}#${group.id}`}>{en ? 'More in this category' : '浏览同类作品'} ↗</a></div>
          </section>
        </article>
      </div>
    </main>
  </body>
</html>

<style>
  .repository-project h1 { max-width: 13ch; overflow-wrap: anywhere; font-size: clamp(2.8rem, 5vw, 5rem); line-height: 1.06; letter-spacing: -.035em; }
  .repository-artwork { margin: 0; align-self: center; }
  .repository-artwork :global(svg) { display: block; width: 100%; height: auto; }
  .repository-artwork figcaption { margin-top: 12px; color: var(--detail-soft); font-size: 12px; }
  .repository-workflow { margin: 28px 0 0; padding: 0; list-style: none; }
  .repository-workflow li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 16px; padding: 24px 0; border-top: 1px solid var(--detail-line); }
  .repository-workflow li > span { color: var(--detail-red); font-size: 14px; font-weight: 700; }
  .repository-workflow h3 { margin: 0 0 10px; font-size: 20px; }
  .repository-workflow p { margin: 0; }
  .repository-boundaries { padding-left: 1.3em; line-height: 1.85; }
  .repository-boundaries li + li { margin-top: 14px; }
  .repository-upstream { display: inline-block; padding-block: 12px; text-decoration: underline; text-underline-offset: 4px; overflow-wrap: anywhere; }
  .repository-sources { margin: 28px 0; padding: 0; list-style: none; }
  .repository-sources a { display: flex; flex-direction: column; gap: 8px; padding: 20px 0; border-bottom: 1px solid var(--detail-line); }
  .repository-sources a:hover strong { color: var(--detail-red); }
  .repository-sources code { font-size: 12px; color: var(--detail-soft); overflow-wrap: anywhere; }
  .repository-project :focus-visible { outline: 3px solid var(--detail-red); outline-offset: 4px; }
</style>
