---
import '../styles/hero.css';

interface Props {
  locale: 'zh' | 'en';
}

const { locale } = Astro.props;
const english = locale === 'en';

// 静态后备堆叠层：4 块彩色图标垫底，11 块 IT–Coder–Yy 字母高低错落微倾排布。
const staticIcons = [
  { key: 'robot', tone: 'blue', x: '17%', y: '2px', r: '-7deg' },
  { key: 'camera', tone: 'peach', x: '41%', y: '0px', r: '6deg' },
  { key: 'git', tone: 'acc', x: '64%', y: '2px', r: '-5deg' },
  { key: 'chip', tone: 'blue', x: '84%', y: '0px', r: '8deg' },
] as const;

const staticLetters = [
  { ch: 'I', small: false, x: '9%', y: '4px', r: '-6deg' },
  { ch: 'T', small: false, x: '17.5%', y: 'var(--stack-mid)', r: '5deg' },
  { ch: '–', small: true, x: '25.5%', y: '6px', r: '-8deg' },
  { ch: 'C', small: false, x: '33.5%', y: '4px', r: '4deg' },
  { ch: 'o', small: false, x: '41.5%', y: 'var(--stack-high)', r: '-5deg' },
  { ch: 'd', small: false, x: '49.5%', y: '6px', r: '7deg' },
  { ch: 'e', small: false, x: '57.5%', y: '18px', r: '-4deg' },
  { ch: 'r', small: false, x: '65.5%', y: 'var(--stack-high)', r: '6deg' },
  { ch: '–', small: true, x: '73.5%', y: '6px', r: '-7deg' },
  { ch: 'Y', small: false, x: '81.5%', y: 'var(--stack-mid)', r: '-5deg' },
  { ch: 'y', small: false, x: '90.5%', y: '4px', r: '8deg' },
] as const;
---

<section
  class="gravity-hero"
  id="top"
  aria-labelledby="hero-title"
  data-view="top"
  data-gravity-hero
  data-locale={locale}
>
  <h1 id="hero-title" class="hero-headline">
    {
      english ? (
        <Fragment><span class="w">Building </span><mark class="blue w">agents</mark><span class="w">, playing with </span><mark class="peach w">pixels</mark><span class="w">,</span><br /><span class="w">and writing handy little tools.</span></Fragment>
      ) : (
        <Fragment><span class="w">做&nbsp;</span><mark class="blue w">Agent</mark><span class="w">、玩</span><mark class="peach w">像素</mark><span class="w">，</span><br /><span class="w">也写顺手的小工具。</span></Fragment>
      )
    }
  </h1>

  <div class="hero-stage" data-hero-stage>
    <div class="hero-static-stage" data-hero-static aria-hidden="true">
      {
        staticIcons.map((icon) => (
          <div
            class:list={['tile', 'ic', icon.tone]}
            style={`--x:${icon.x};--y:${icon.y};--r:${icon.r}`}
          >
            {icon.key === 'robot' && (
              <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="5" y="8" width="14" height="11" rx="3" />
                <path d="M12 4v4M9 13h.01M15 13h.01M9.5 16.5h5" />
              </svg>
            )}
            {icon.key === 'camera' && (
              <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 8h3l2-3h6l2 3h3v11H4z" />
                <circle cx="12" cy="13" r="3.5" />
              </svg>
            )}
            {icon.key === 'git' && (
              <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="6" cy="6" r="2" />
                <circle cx="6" cy="18" r="2" />
                <circle cx="18" cy="8" r="2" />
                <path d="M6 8v8M18 10c0 4-6 3.5-11 6.5" />
              </svg>
            )}
            {icon.key === 'chip' && (
              <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="7" y="7" width="10" height="10" rx="2" />
                <path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4" />
              </svg>
            )}
          </div>
        ))
      }
      {
        staticLetters.map((item) => (
          <div
            class:list={['tile', 'l', { small: item.small }]}
            style={`--x:${item.x};--y:${item.y};--r:${item.r}`}
          >
            {item.ch}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '../scripts/gravity-hero';
</script>
