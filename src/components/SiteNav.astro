---
interface Props {
  locale: 'zh' | 'en';
  pathname: string;
  detail?: boolean;
  showLanguageSwitch?: boolean;
  spatial?: boolean;
}

import '../styles/tokens.css';
import MusicPlayer from './MusicPlayer.astro';
import { sitePath } from '../lib/paths';

const { locale, pathname, detail = false, showLanguageSwitch = true } = Astro.props;
const isEnglish = locale === 'en';
const isHome = pathname === '/' || pathname === '/en';
const isBlog = pathname === '/blog' || pathname.startsWith('/blog/');
const isBlogArticle = pathname.startsWith('/blog/') && pathname !== '/blog/';
const isProject = detail || pathname.includes('/projects/');
const isDetailView = isProject || isBlogArticle;
const home = isEnglish ? sitePath('/en') : sitePath('/');
const backFallback = isBlogArticle ? sitePath('/blog') : `${home}#projects`;
const backLabel = isEnglish ? 'Go back to previous page' : '返回上一页';
const progressLabel = isEnglish ? 'Reading progress' : '阅读进度';
const alternate = isEnglish
  ? sitePath(pathname === '/en' ? '/' : pathname.replace(/^\/en/, ''))
  : sitePath(pathname === '/' ? '/en' : `/en${pathname}`);
const switchLabel = isEnglish ? 'Language selection' : '语言选择';
const githubUrl = 'https://github.com/IT-coder-Yy';
---

{isDetailView && (
  <div
    class="reading-ruler"
    data-reading-ruler
    role="progressbar"
    aria-label={progressLabel}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <div class="reading-ruler-track">
      <div class="reading-ruler-fill" data-ruler-fill></div>
    </div>
    <div class="reading-ruler-ticks" data-ruler-ticks aria-hidden="true">
      {Array.from({ length: 41 }).map((_, i) => (
        <span
          class:list={[
            'reading-ruler-tick',
            i % 10 === 0 ? 'is-major' : i % 4 === 0 ? 'is-mid' : undefined,
          ]}
          data-tick-pct={String(i / 40)}
        />
      ))}
    </div>
    <div class="reading-ruler-chapters" data-ruler-chapters></div>
    <div class="reading-ruler-badge" data-ruler-badge aria-hidden="true">
      <span class="reading-ruler-dot"></span>
      <span data-ruler-pct>0%</span>
    </div>
  </div>
)}

<header class:list={['site-header', { 'is-detail-nav': isDetailView }]} data-site-header>
  <div class="nav-brand-slot">
    <a
      class="nav-pill nav-logo"
      href={isHome ? '#top' : `${home}#top`}
      aria-label={isEnglish ? 'IT-coder-Yy portfolio home' : 'IT-coder-Yy 个人作品集首页'}
    >Yy</a>
    {isDetailView && (
      <a
        class="nav-pill nav-back"
        href={backFallback}
        data-smart-back
        aria-label={backLabel}
        title={backLabel}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 12H5" />
          <path d="M11 6l-6 6 6 6" />
        </svg>
      </a>
    )}
  </div>

  <nav
    id="primary-navigation"
    class="nav-pill nav-links"
    data-site-nav
    aria-label={isEnglish ? 'Primary navigation' : '主导航'}
  >
    <a
      class="nav-link"
      data-view-link={isHome ? 'top' : undefined}
      href={isHome ? '#top' : `${home}#top`}
      aria-current={isHome ? 'page' : undefined}
    >{isEnglish ? 'Home' : '首页'}</a>
    <i class="nav-sep" aria-hidden="true"></i>
    <a
      class="nav-link"
      data-view-link={isHome ? 'projects' : undefined}
      href={isHome ? '#projects' : `${home}#projects`}
      aria-current={!isHome && isProject ? 'page' : undefined}
    >{isEnglish ? 'Work' : '作品'}</a>
    <i class="nav-sep" aria-hidden="true"></i>
    <a
      class="nav-link"
      href={sitePath('/blog')}
      aria-current={isBlog ? 'page' : undefined}
    >{isEnglish ? 'Notes' : '手记'}</a>
    <i class="nav-sep" aria-hidden="true"></i>
    <a
      class="nav-link"
      data-view-link={isHome ? 'about' : undefined}
      href={isHome ? '#about' : `${home}#about`}
    >{isEnglish ? 'About' : '关于'}</a>

    <div class="nav-drawer-extras">
      <a
        class="nav-drawer-github"
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
        </svg>
        <span>GitHub ↗</span>
      </a>
      {showLanguageSwitch && (
        <div class="language-switch" role="group" aria-label={switchLabel}>
          {isEnglish ? (
            <>
              <a class="language-option" href={alternate} lang="zh-CN" hreflang="zh-CN" aria-label="切换至中文版">中</a>
              <span class="language-sep" aria-hidden="true">/</span>
              <strong class="language-option" lang="en" aria-current="page">EN</strong>
            </>
          ) : (
            <>
              <strong class="language-option" lang="zh-CN" aria-current="page">中</strong>
              <span class="language-sep" aria-hidden="true">/</span>
              <a class="language-option" href={alternate} lang="en" hreflang="en" aria-label="Switch to English">EN</a>
            </>
          )}
        </div>
      )}
    </div>
  </nav>

  <div class="nav-right">
    <a
      class="nav-pill nav-icon-pill nav-github-desktop"
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
      </svg>
    </a>

    <div
      class="nav-pill theme-seg"
      role="group"
      aria-label={isEnglish ? 'Theme mode' : '主题切换'}
      data-theme-switcher
    >
      <span class="theme-knob" aria-hidden="true"></span>
      <button
        class="theme-btn"
        type="button"
        data-theme-mode="light"
        aria-pressed="false"
        aria-label={isEnglish ? 'Light theme' : '亮色主题'}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      <button
        class="theme-btn"
        type="button"
        data-theme-mode="dark"
        aria-pressed="false"
        aria-label={isEnglish ? 'Dark theme' : '暗色主题'}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
      <button
        class="theme-btn"
        type="button"
        data-theme-mode="system"
        aria-pressed="false"
        aria-label={isEnglish ? 'System theme' : '跟随系统'}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="4" width="18" height="12" rx="2" />
          <path d="M8 20h8M12 16v4" />
        </svg>
      </button>
    </div>

    {showLanguageSwitch && (
      <div class="nav-pill language-switch language-switch-desktop" role="group" aria-label={switchLabel}>
        {isEnglish ? (
          <>
            <a class="language-option" href={alternate} lang="zh-CN" hreflang="zh-CN" aria-label="切换至中文版">中</a>
            <span class="language-sep" aria-hidden="true">/</span>
            <strong class="language-option" lang="en" aria-current="page">EN</strong>
          </>
        ) : (
          <>
            <strong class="language-option" lang="zh-CN" aria-current="page">中</strong>
            <span class="language-sep" aria-hidden="true">/</span>
            <a class="language-option" href={alternate} lang="en" hreflang="en" aria-label="Switch to English">EN</a>
          </>
        )}
      </div>
    )}

    <button
      class="nav-pill nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label={isEnglish ? 'Open navigation' : '打开主导航'}
    >
      <span>{isEnglish ? 'Menu' : '菜单'}</span>
      <i aria-hidden="true"><b></b><b></b></i>
    </button>
  </div>
</header>

<MusicPlayer locale={locale} />

<script>
  import { onPageLoad } from '../lib/page-lifecycle';

  type ThemeMode = 'light' | 'dark' | 'system';
  const STORAGE_KEY = 'site-theme';
  const TRAIL_KEY = 'site-nav-trail';
  const MAX_TRAIL = 20;
  const MODES: readonly ThemeMode[] = ['light', 'dark', 'system'];

  const normalizeRouteKey = (urlLike: string): string => {
    try {
      const u = new URL(urlLike, window.location.origin);
      return u.pathname.replace(/\/+$/, '') || '/';
    } catch {
      return '/';
    }
  };

  const toRelativeHref = (urlLike: string): string => {
    try {
      const u = new URL(urlLike, window.location.origin);
      return `${u.pathname}${u.search}${u.hash}`;
    } catch {
      return '/';
    }
  };

  const readTrail = (): string[] => {
    try {
      const raw = window.sessionStorage.getItem(TRAIL_KEY);
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.isArray(parsed)
        ? parsed.filter((item): item is string => typeof item === 'string')
        : [];
    } catch {
      return [];
    }
  };

  const writeTrail = (trail: string[]) => {
    try {
      window.sessionStorage.setItem(TRAIL_KEY, JSON.stringify(trail.slice(-MAX_TRAIL)));
    } catch {}
  };

  const recordTrailHref = (href: string): string[] => {
    const rel = toRelativeHref(href);
    const key = normalizeRouteKey(rel);
    const trail = readTrail();

    if (trail.length === 0 && document.referrer) {
      try {
        const ref = new URL(document.referrer);
        if (ref.origin === window.location.origin) {
          const refRel = `${ref.pathname}${ref.search}${ref.hash}`;
          if (normalizeRouteKey(refRel) !== key) {
            trail.push(refRel);
          }
        }
      } catch {}
    }

    const existingIndex = trail.findIndex((entry) => normalizeRouteKey(entry) === key);
    if (existingIndex >= 0) {
      const next = trail.slice(0, existingIndex + 1);
      next[existingIndex] = rel;
      writeTrail(next);
      return next;
    }

    const next = [...trail, rel].slice(-MAX_TRAIL);
    writeTrail(next);
    return next;
  };

  const winWithNavHook = window as Window & { __siteNavTrailHooked?: boolean };
  if (!winWithNavHook.__siteNavTrailHooked) {
    winWithNavHook.__siteNavTrailHooked = true;
    // Capture latest hash (including replaceState category filters) right before leaving a page
    document.addEventListener('astro:before-preparation', () => {
      recordTrailHref(window.location.href);
    });
    window.addEventListener('hashchange', () => {
      recordTrailHref(window.location.href);
    });
  }

  const resolveTheme = (mode: ThemeMode): 'light' | 'dark' => {
    if (mode === 'light') return 'light';
    if (mode === 'dark') return 'dark';
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };

  const normalizeMode = (value: string | undefined): ThemeMode =>
    value === 'light' || value === 'dark' || value === 'system' ? value : 'system';

  const syncThemeUI = (switcher: HTMLElement, mode: ThemeMode) => {
    const idx = MODES.indexOf(mode);
    switcher.style.setProperty('--seg-idx', String(idx >= 0 ? idx : 2));
    switcher.querySelectorAll<HTMLButtonElement>('[data-theme-mode]').forEach((btn) => {
      const active = btn.dataset.themeMode === mode;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', String(active));
    });
  };

  onPageLoad((signal) => {
    const header = document.querySelector<HTMLElement>('[data-site-header]');

    if (header) {
      const toggle = header.querySelector<HTMLButtonElement>('.nav-toggle');
      const navigation = header.querySelector<HTMLElement>('[data-site-nav]');

      const setMenu = (open: boolean) => {
        header.classList.toggle('is-open', open);
        toggle?.setAttribute('aria-expanded', String(open));
        const isZh = document.documentElement.lang.startsWith('zh');
        toggle?.setAttribute(
          'aria-label',
          open
            ? (isZh ? '关闭主导航' : 'Close navigation')
            : (isZh ? '打开主导航' : 'Open navigation'),
        );
      };

      toggle?.addEventListener(
        'click',
        () => {
          setMenu(toggle.getAttribute('aria-expanded') !== 'true');
        },
        { signal },
      );

      navigation?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenu(false), { signal });
      });

      document.addEventListener(
        'click',
        (event) => {
          if (!header.classList.contains('is-open')) return;
          const target = event.target as Node | null;
          if (target && !header.contains(target)) {
            setMenu(false);
          }
        },
        { signal },
      );

      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape' && header.classList.contains('is-open')) {
            setMenu(false);
            toggle?.focus();
          }
        },
        { signal },
      );

      const switcher = header.querySelector<HTMLElement>('[data-theme-switcher]');
      if (switcher) {
        const currentMode = normalizeMode(document.documentElement.dataset.themeMode);
        syncThemeUI(switcher, currentMode);

        switcher.addEventListener(
          'click',
          (event) => {
            const target = event.target as HTMLElement | null;
            const button = target?.closest<HTMLButtonElement>('[data-theme-mode]');
            if (!button) return;

            const mode = normalizeMode(button.dataset.themeMode);
            try {
              window.localStorage.setItem(STORAGE_KEY, mode);
            } catch {}

            const resolved = resolveTheme(mode);
            const previousTheme = document.documentElement.dataset.theme;
            const apply = () => {
              document.documentElement.dataset.theme = resolved;
              document.documentElement.dataset.themeMode = mode;
              const meta = document.querySelector('meta[name="theme-color"]');
              if (meta) {
                meta.setAttribute('content', resolved === 'dark' ? '#121212' : '#f6f5f1');
              }
              syncThemeUI(switcher, mode);
            };

            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const startVT = (document as Document & {
              startViewTransition?: (cb: () => void) => {
                ready: Promise<void>;
                finished: Promise<void>;
              };
            }).startViewTransition;

            if (typeof startVT !== 'function' || resolved === previousTheme || reducedMotion) {
              apply();
              return;
            }

            let x = event.clientX;
            let y = event.clientY;
            if (x === 0 && y === 0) {
              const rect = button.getBoundingClientRect();
              x = rect.left + rect.width / 2;
              y = rect.top + rect.height / 2;
            }
            const radius = Math.hypot(
              Math.max(x, window.innerWidth - x),
              Math.max(y, window.innerHeight - y),
            );

            document.documentElement.classList.add('theme-transitioning');
            const transition = startVT.call(document, apply);

            transition.ready
              .then(() => {
                document.documentElement.animate(
                  {
                    clipPath: [
                      `circle(0px at ${x}px ${y}px)`,
                      `circle(${radius}px at ${x}px ${y}px)`,
                    ],
                  },
                  {
                    duration: 650,
                    easing: 'cubic-bezier(.65, 0, .35, 1)',
                    pseudoElement: '::view-transition-new(root)',
                  },
                );
              })
              .catch(() => {});

            transition.finished.finally(() => {
              document.documentElement.classList.remove('theme-transitioning');
            });
          },
          { signal },
        );
      }
    }

    const chapterLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.chapter-rail a[href^="#"]'),
    );
    const chapterSections = chapterLinks
      .map((link) => document.querySelector<HTMLElement>(link.hash))
      .filter((section): section is HTMLElement => Boolean(section));

    if (chapterSections.length && 'IntersectionObserver' in window) {
      const chapterObserver = new IntersectionObserver(
        (entries) => {
          const active = entries.find((entry) => entry.isIntersecting)?.target as HTMLElement | undefined;
          if (!active) return;
          chapterLinks.forEach((link) => {
            if (link.hash === `#${active.id}`) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        },
        { rootMargin: '-18% 0px -70%', threshold: 0 },
      );
      signal.addEventListener('abort', () => chapterObserver.disconnect(), { once: true });
      chapterSections.forEach((section) => chapterObserver.observe(section));
    }

    // Record current page into the deduplicated same-origin navigation trail
    const trail = recordTrailHref(window.location.href);

    // Smart back navigation: link directly to the recorded previous route (preserving hash/category),
    // avoiding history.back() which Astro ClientRouter ignores when hash history entries have state === null
    const smartBack = document.querySelector<HTMLAnchorElement>('[data-smart-back]');
    if (smartBack && trail.length >= 2) {
      const prevEntry = trail[trail.length - 2];
      if (prevEntry && normalizeRouteKey(prevEntry) !== normalizeRouteKey(window.location.href)) {
        smartBack.setAttribute('href', prevEntry);
      }
    }

    // Top precision reading ruler: 3px bar + 41 ticks + chapter milestones + light cursor-tracking % pill
    const ruler = document.querySelector<HTMLElement>('[data-reading-ruler]');
    if (ruler) {
      const fill = ruler.querySelector<HTMLElement>('[data-ruler-fill]');
      const badge = ruler.querySelector<HTMLElement>('[data-ruler-badge]');
      const pctEl = ruler.querySelector<HTMLElement>('[data-ruler-pct]');
      const chaptersHost = ruler.querySelector<HTMLElement>('[data-ruler-chapters]');
      const tickEls = Array.from(ruler.querySelectorAll<HTMLElement>('[data-tick-pct]'));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const collectChapters = (): Array<{ label: string; target: HTMLElement }> => {
        if (chapterLinks.length) {
          return chapterLinks
            .map((link) => {
              const target = document.querySelector<HTMLElement>(link.hash);
              const label = link.textContent?.trim() ?? '';
              return target && label ? { label, target } : null;
            })
            .filter((item): item is { label: string; target: HTMLElement } => Boolean(item));
        }

        const tocPrimaryLinks = Array.from(
          document.querySelectorAll<HTMLAnchorElement>(
            '[data-table-of-contents] li:not(.toc-level-three) > a[href^="#"]',
          ),
        );
        const tocFallbackLinks = tocPrimaryLinks.length
          ? tocPrimaryLinks
          : Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-table-of-contents] a[href^="#"]'));

        if (tocFallbackLinks.length) {
          return tocFallbackLinks
            .map((link) => {
              const id = decodeURIComponent(link.hash.slice(1));
              const target = document.getElementById(id);
              const label = link.textContent?.trim() ?? '';
              return target && label ? { label, target } : null;
            })
            .filter((item): item is { label: string; target: HTMLElement } => Boolean(item));
        }

        return Array.from(document.querySelectorAll<HTMLElement>('.article-prose h2[id]'))
          .map((heading) => ({
            label: heading.textContent?.trim() ?? '',
            target: heading,
          }))
          .filter((item) => Boolean(item.label));
      };

      const chapters = collectChapters();
      let chapterMarkers: Array<{ btn: HTMLButtonElement; ratio: number }> = [];

      const getMaxScroll = () =>
        Math.max(0, document.documentElement.scrollHeight - window.innerHeight);

      const rebuildChapters = () => {
        if (!chaptersHost) return;
        chaptersHost.replaceChildren();
        chapterMarkers = [];
        const max = getMaxScroll();
        if (max <= 0 || !chapters.length) return;

        const offset = 112;
        chapters.forEach(({ label, target }) => {
          const top = Math.max(0, target.getBoundingClientRect().top + window.scrollY - offset);
          const ratio = Math.min(0.96, Math.max(0.04, top / max));
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'reading-ruler-chapter';
          if (ratio < 0.14) btn.classList.add('is-left');
          else if (ratio > 0.86) btn.classList.add('is-right');
          btn.style.left = `${(ratio * 100).toFixed(2)}%`;
          btn.setAttribute('aria-label', label);

          const dot = document.createElement('span');
          dot.className = 'reading-ruler-chapter-dot';
          dot.setAttribute('aria-hidden', 'true');

          const tip = document.createElement('span');
          tip.className = 'reading-ruler-chapter-tip';
          tip.setAttribute('aria-hidden', 'true');
          tip.textContent = label;

          btn.append(dot, tip);
          btn.addEventListener(
            'click',
            () => {
              target.scrollIntoView({
                behavior: reducedMotion.matches ? 'auto' : 'smooth',
                block: 'start',
              });
            },
            { signal },
          );
          chaptersHost.append(btn);
          chapterMarkers.push({ btn, ratio });
        });
      };

      let frame = 0;
      const updateRuler = () => {
        frame = 0;
        const max = getMaxScroll();
        const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
        const pct = Math.round(ratio * 100);

        if (fill) fill.style.transform = `scaleX(${ratio})`;
        if (pctEl) pctEl.textContent = `${pct}%`;
        ruler.setAttribute('aria-valuenow', String(pct));

        tickEls.forEach((tick) => {
          const tickPct = Number(tick.dataset.tickPct ?? '0');
          tick.classList.toggle('is-passed', ratio > 0 && tickPct <= ratio + 0.004);
        });

        chapterMarkers.forEach(({ btn, ratio: chRatio }) => {
          btn.classList.toggle('is-passed', ratio >= chRatio - 0.015);
        });

        if (badge) {
          const viewportW = document.documentElement.clientWidth || window.innerWidth;
          const badgeW = badge.offsetWidth || 48;
          const pad = 8;
          const rawX = ratio * viewportW;
          const minCenter = badgeW / 2 + pad;
          const maxCenter = Math.max(minCenter, viewportW - badgeW / 2 - pad);
          const clampedCenter = Math.min(maxCenter, Math.max(minCenter, rawX));
          const leftPx = clampedCenter - badgeW / 2;
          const tipPx = Math.min(badgeW - 8, Math.max(8, rawX - leftPx));

          badge.style.transform = `translate3d(${leftPx.toFixed(1)}px, 0, 0)`;
          badge.style.setProperty('--tip-x', `${tipPx.toFixed(1)}px`);
        }
      };

      const scheduleUpdate = () => {
        if (!frame) frame = requestAnimationFrame(updateRuler);
      };

      let layoutFrame = 0;
      const scheduleLayout = () => {
        if (layoutFrame) return;
        layoutFrame = requestAnimationFrame(() => {
          layoutFrame = 0;
          rebuildChapters();
          updateRuler();
        });
      };

      rebuildChapters();
      updateRuler();

      window.addEventListener('scroll', scheduleUpdate, { passive: true, signal });
      window.addEventListener('resize', scheduleLayout, { passive: true, signal });

      if ('ResizeObserver' in window) {
        const ro = new ResizeObserver(scheduleLayout);
        ro.observe(document.body);
        signal.addEventListener('abort', () => ro.disconnect(), { once: true });
      }

      signal.addEventListener(
        'abort',
        () => {
          if (frame) cancelAnimationFrame(frame);
          if (layoutFrame) cancelAnimationFrame(layoutFrame);
        },
        { once: true },
      );
    }
  });
</script>
