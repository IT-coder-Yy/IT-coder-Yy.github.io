---
import { ClientRouter } from 'astro:transitions';
import litEmblem from '../assets/images/lit-official-emblem-transparent.png';
import ucasEmblem from '../assets/images/ucas-official-emblem.png';
import travelInterface from '../assets/images/super-travel-agent-interface.png';
import ThemeScript from './ThemeScript.astro';
import IntroKeypad from './IntroKeypad.astro';
import GravityHero from './GravityHero.astro';
import SiteNav from './SiteNav.astro';
import ProjectCover from './ProjectCover.astro';
import ProjectPreview from './ProjectPreview.astro';
import NavIcon from './NavIcon.astro';
import { projects, projectGroups, type Artwork, type Locale, type ProjectGroup } from '../data/portfolio';
import { sitePath } from '../lib/paths';
import '../styles/portfolio-home.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const english = locale === 'en';
const projectUrl = (slug: string) => sitePath(`${english ? '/en' : ''}/projects/${slug}`);

const splitProjectTitle = (title: string): [string, string] => {
  const index = title.indexOf(' · ');
  return index === -1 ? [title, ''] : [title.slice(0, index), title.slice(index + 3)];
};

const shortGroupLabels: Record<ProjectGroup, Record<Locale, string>> = {
  agent: { zh: 'AI 应用', en: 'AI Apps' },
  media: { zh: '视频', en: 'Video' },
  tools: { zh: '开发工具', en: 'Dev Tools' },
  vision: { zh: '视觉 · C++', en: 'Vision · C++' },
};

const groupCounts = Object.fromEntries(
  projectGroups.map((group) => [
    group.kind,
    projects.filter((project) => project.group === group.kind).length,
  ]),
) as Record<ProjectGroup, number>;

const stackItems = [
  {
    label: 'AI Agents / MCP',
    icon: '<rect x="5" y="8" width="14" height="11" rx="3"/><path d="M12 4v4M9 13h.01M15 13h.01M9.5 16.5h5"/>',
  },
  {
    label: 'Python / FastAPI',
    icon: '<rect x="3" y="4" width="18" height="16" rx="3"/><path d="M7 9l3 3-3 3M12 15h5"/>',
  },
  {
    label: 'C++ / Qt',
    icon: '<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 6l-3 12"/>',
  },
  {
    label: 'Computer Vision',
    icon: '<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>',
  },
  {
    label: 'ONNX / MNN',
    icon: '<circle cx="6" cy="6" r="2.2"/><circle cx="18" cy="6" r="2.2"/><circle cx="12" cy="18" r="2.2"/><path d="M7.9 7.3l3 8.8M16.1 7.3l-3 8.8M8.2 6h7.6"/>',
  },
  {
    label: 'Embedded / RTOS',
    icon: '<rect x="7" y="7" width="10" height="10" rx="2"/><path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4"/>',
  },
  {
    label: 'TypeScript / Astro',
    icon: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>',
  },
] as const;

const text = english
  ? {
      title: 'IT-Coder-Yy · Personal Space',
      description:
        'IT-Coder-Yy’s personal space: AI Agents, AI applications, computer vision, C++ engineering, and handy tools.',
      skip: 'Skip to content',
      nav: 'Project categories',
      workTitle: 'Things I Built',
      workIntro:
        'Click a tile on the isometric canvas to preview, or pick a category to inspect the full cards.',
      canvasHint: 'Hover & click any tile to preview ↗',
      dragHint: 'Drag a card by its handle to move it around.',
      all: 'All',
      reset: 'Reset cards',
      case: 'Read case study',
      evidence: 'Role & evidence',
      move: 'Move card: ',
      myRole: 'My role',
      interface: 'Existing project interface',
      aboutTitle: 'Hi, I’m IT-Coder-Yy',
      aboutSubhead:
        'Studying AI at UCAS — turning ideas around AI Agents, computer vision, C++, and handy tools into things that actually run.',
      aboutIntro:
        'I spend most of my time building AI Agents and practical AI apps, alongside computer vision pipelines, C++ desktop tools, and embedded systems. Beyond prototypes, I care about constraints, tool boundaries, state, and making software hold up in real workflows.',
      directionsKicker: 'TWO THREADS',
      educationKicker: 'EDUCATION',
      stackKicker: 'STACK & TOOLS',
      ucas: 'University of Chinese Academy of Sciences',
      ucasDegree: 'MSc · Artificial Intelligence',
      lit: 'Luoyang Institute of Science and Technology',
      litDegree: 'BEng · Internet of Things Engineering',
      contact: 'Say hi or build together',
      contactIntro:
        'Whether you’re working on interesting AI apps, engineering tools, or just want to swap notes on a project, feel free to write.',
      copy: 'Copy email',
      copied: 'Email copied',
      copyError: 'Could not copy. Please select the email address.',
      visitGithub: 'Visit profile',
      backHome: 'Back to home ↑',
    }
  : {
      title: 'IT-Coder-Yy · 个人空间',
      description:
        'IT-Coder-Yy 的个人空间：AI Agent、AI 应用开发、计算机视觉、C++ 工程实践与顺手的小工具。',
      skip: '跳至正文',
      nav: '作品分类',
      workTitle: '做过的东西',
      workIntro: '全部视图里可以直接点开等距画布预览；切到具体分类，展开完整实体卡片桌面。',
      canvasHint: '轻移鼠标感受视角，点击任意作品预览 ↗',
      dragHint: '轻拖右上角把手，可以把卡片随意挪开看看。',
      all: '全部',
      reset: '卡片归位',
      case: '阅读项目案例',
      evidence: '职责与工程证据',
      move: '移动作品卡片：',
      myRole: '我的职责',
      interface: '现有项目界面',
      aboutTitle: '你好，我是 IT-Coder-Yy',
      aboutSubhead:
        '在中科院大学读 AI，喜欢把 Agent、计算机视觉、C++ 和顺手的小工具从想法做成能跑的东西。',
      aboutIntro:
        '平时主要折腾 AI Agent 与智能应用，也常和红外图像、C++ 上位机及嵌入式设备打交道。比起停留在 Demo 里的灵光一现，我更在意约束怎么落、工具怎么接、边界怎么守住，让程序在真实场景里稳定跑起来。',
      directionsKicker: '两个主要方向',
      educationKicker: '教育背景',
      stackKicker: '常用技术与工具',
      ucas: '中国科学院大学',
      ucasDegree: '人工智能硕士',
      lit: '洛阳理工学院',
      litDegree: '物联网工程本科',
      contact: '一起聊点有意思的',
      contactIntro: '无论是在做有趣的 AI 应用、工程工具，还是想聊聊某个项目的实现细节，都欢迎来信。',
      copy: '复制邮箱',
      copied: '邮箱已复制',
      copyError: '复制失败，请选中邮箱文字复制。',
      visitGithub: '访问主页',
      backHome: '返回首页 ↑',
    };

const tilts: Record<Artwork, string> = {
  travel: '-2.2deg',
  freight: '1.8deg',
  camera: '1.8deg',
  safety: '-2deg',
  recruitment: '1.8deg',
  prompt: '-2deg',
  minimax: '-2.2deg',
  video: '1.8deg',
  git: '-2.2deg',
  random: '1.8deg',
};
---

<!doctype html>
<html lang={english ? 'en' : 'zh-CN'}>
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={text.description} />
    <meta name="theme-color" content="#f6f5f1" />
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <ThemeScript />
    <title>{text.title}</title>
  </head>
  <body class="portfolio-home">
    <a class="skip-link" href="#content">{text.skip}</a>
    <IntroKeypad locale={locale} />

    <div class="page-shell">
      <SiteNav locale={locale} pathname={english ? '/en' : '/'} spatial />

      <main id="content">
        <GravityHero locale={locale} />

        <section
          class="portfolio-desk"
          id="projects"
          aria-labelledby="work-title"
          data-project-desk
          data-view="projects"
        >
          <div class="work-heading">
            <div class="work-heading-copy">
              <div class="sec-num">02 / WORKS</div>
              <h2 id="work-title">
                {text.workTitle} <span class="sec-count">[<b>{projects.length}</b>]</span>
              </h2>
              <p class="work-intro">{text.workIntro}</p>
            </div>
            <span class="desk-hint" data-desk-hint-canvas>{text.canvasHint}</span>
            <span class="desk-hint" data-desk-hint-cards hidden>{text.dragHint}</span>
          </div>

          <div class="work-tools">
            <div class="project-filters work-chips" data-chip-group role="group" aria-label={text.nav}>
              <span class="chip-ind" data-chip-ind aria-hidden="true"></span>
              <button
                type="button"
                class="is-active"
                data-project-filter="all"
                aria-pressed="true"
              >
                {text.all}<span>[{projects.length}]</span>
              </button>
              {projectGroups.map((group) => (
                <button
                  type="button"
                  data-project-filter={group.kind}
                  aria-pressed="false"
                >
                  {shortGroupLabels[group.kind][locale]}<span>[{groupCounts[group.kind]}]</span>
                </button>
              ))}
            </div>

            <button class="reset-cards" type="button" data-reset-cards hidden>
              <span>{text.reset}</span>
              <span class="reset-icon" aria-hidden="true">↺</span>
            </button>
          </div>

          <div class="works-canvas-stage" data-works-canvas>
            <div class="works-canvas-scene">
              <div class="isometric-canvas" data-isometric-canvas>
                <div class="canvas-lettering" aria-hidden="true">
                  <p class="canvas-brand">IT-Coder-Yy</p>
                  <p class="canvas-sub">SELECTED WORK / {projects.length} PROJECTS</p>
                </div>
                {projects.map((project) => (
                  <a
                    class:list={['canvas-project', `canvas-${project.id}`]}
                    href={projectUrl(project.slug)}
                    data-preview-open={project.id}
                    aria-label={english ? `Preview ${project.name.en}` : `预览${project.name.zh}`}
                  >
                    <div class="canvas-object">
                      <ProjectCover kind={project.id} locale={locale} eager />
                      <span class="canvas-object-title">
                        <span>{project.shortName[locale]}</span>
                        <span aria-hidden="true">↗</span>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </div>

          <div class="work-groups" data-works-groups hidden>
            {projectGroups.map((group) => (
              <section
                class="work-group"
                id={group.id}
                data-project-group={group.kind}
                aria-labelledby={`${group.id}-title`}
                hidden
              >
                <div class="group-header">
                  <h3 class="group-label" id={`${group.id}-title`}>{group.label[locale]}</h3>
                  <span class="group-count">[{groupCounts[group.kind]}]</span>
                </div>
                <div class="work-group-cards">
                  {projects
                    .filter((project) => project.group === group.kind)
                    .map((project) => {
                      const [mainTitle, subTitle] = splitProjectTitle(project.name[locale]);
                      return (
                        <article
                          class="photo-card"
                          data-project-card={project.id}
                          style={`--card-tilt:${tilts[project.id]}`}
                          aria-labelledby={`work-${project.id}-title`}
                        >
                          <div class="photo-card-meta">
                            <span>{project.ownership[locale]}</span>
                            <button
                              class="card-handle"
                              type="button"
                              data-card-handle
                              aria-label={`${text.move}${project.name[locale]}`}
                              aria-describedby="drag-instructions"
                            >
                              <NavIcon name="grip" />
                            </button>
                          </div>

                          <a
                            class="artwork-link"
                            href={projectUrl(project.slug)}
                            data-preview-open={project.id}
                            aria-label={
                              english ? `Preview ${project.name.en}` : `预览${project.name.zh}`
                            }
                          >
                            <ProjectCover kind={project.id} locale={locale} />
                            <span class="artwork-preview-label">
                              {english ? 'Watch film ↗' : '观看短片 ↗'}
                            </span>
                          </a>

                          <div class="photo-card-content">
                            <h4 id={`work-${project.id}-title`}>
                              <a href={projectUrl(project.slug)}>
                                <span class="card-title-main">{mainTitle}</span>
                                {subTitle && <span class="card-title-sub">{subTitle}</span>}
                              </a>
                            </h4>

                            <p class="card-summary">{project.summary[locale]}</p>

                            <ul
                              class="project-tags"
                              aria-label={english ? 'Technologies' : '技术重点'}
                            >
                              {project.tags.map((tag) => (
                                <li>{tag}</li>
                              ))}
                            </ul>

                            <div class="card-actions">
                              <a class="case-link" href={projectUrl(project.slug)}>
                                {text.case}
                                <NavIcon name="arrow" />
                              </a>
                              {project.source && (
                                <a
                                  class="source-link"
                                  href={project.source}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                >
                                  GitHub ↗
                                </a>
                              )}
                            </div>

                            <details class="card-evidence">
                              <summary>
                                {project.caseStudy
                                  ? english
                                    ? 'Implementation & evidence'
                                    : '实现与工程证据'
                                  : text.evidence}
                                <span aria-hidden="true">+</span>
                              </summary>
                              <div>
                                <p class="card-role">
                                  <b>
                                    {project.caseStudy
                                      ? english
                                        ? 'Implementation scope'
                                        : '实现范围'
                                      : text.myRole}
                                  </b>
                                  {project.role[locale]}
                                </p>
                                <ul>
                                  {project.proofs[locale].map(([title, proof]) => (
                                    <li>
                                      <strong>{title}</strong>
                                      <span>{proof}</span>
                                    </li>
                                  ))}
                                </ul>
                                {project.id === 'travel' && (
                                  <figure class="card-interface">
                                    <img
                                      src={travelInterface.src}
                                      width={travelInterface.width}
                                      height={travelInterface.height}
                                      loading="lazy"
                                      alt={text.interface}
                                    />
                                    <figcaption>{text.interface}</figcaption>
                                  </figure>
                                )}
                              </div>
                            </details>
                          </div>
                        </article>
                      );
                    })}
                </div>
              </section>
            ))}
          </div>

          <p id="drag-instructions" class="visually-hidden">
            {english
              ? 'Drag the handle to reposition this card. With keyboard focus, use arrow keys to move and Home to reset. Card positions do not change project order.'
              : '拖动把手可移动卡片；把手获得键盘焦点后，方向键移动，Home 键归位。卡片摆放不会改变项目阅读顺序。'}
          </p>
          <p class="visually-hidden" aria-live="polite" data-desk-status></p>
        </section>

        <section
          class="about-section"
          id="about"
          aria-labelledby="about-title"
          data-view="about"
        >
          <div class="about-introduction">
            <div class="personal-letter">
              <div class="sec-num">03 / ABOUT</div>
              <h2 id="about-title">{text.aboutTitle}</h2>
              <p class="section-subhead">{text.aboutSubhead}</p>
              <p class="about-lead">{text.aboutIntro}</p>
            </div>

            <div class="personal-directions">
              <span class="section-kicker">{text.directionsKicker}</span>
              <a class="direction-card" href="#ai-agent">
                <span class="direction-code">01 / AGENTS</span>
                <h3>{english ? 'From intent to action' : '从意图到行动'}</h3>
                <p>
                  {english
                    ? 'Planning, tools and memory — organizing reasoning loops so every decision stays grounded.'
                    : '把规划、工具与记忆组织起来，让每一次决策都清晰有迹可循。'}
                </p>
                <b>{english ? 'Explore Agent work ↗' : '探索 Agent 作品 ↗'}</b>
              </a>

              <a class="direction-card" href="#cv">
                <span class="direction-code">02 / PERCEPTION</span>
                <h3>{english ? 'From signals to systems' : '从信号到系统'}</h3>
                <p>
                  {english
                    ? 'Vision, inference deployment and concurrency — bringing perception smoothly into real applications.'
                    : '把视觉算法、推理部署与并发处理接起来，让感知真正进入可用应用。'}
                </p>
                <b>{english ? 'Explore vision & C++ work ↗' : '探索视觉与 C++ 作品 ↗'}</b>
              </a>
            </div>
          </div>

          <div class="about-block education-block">
            <span class="section-kicker">{text.educationKicker}</span>
            <div class="education-records">
              <article class="education-card">
                <span class="emblem-badge">
                  <img
                    src={ucasEmblem.src}
                    width="48"
                    height="48"
                    loading="lazy"
                    alt={english ? 'UCAS official emblem' : '中国科学院大学官方校徽'}
                  />
                </span>
                <div>
                  <h3>{text.ucas}</h3>
                  <p>{text.ucasDegree}</p>
                </div>
              </article>

              <article class="education-card">
                <span class="emblem-badge">
                  <img
                    src={litEmblem.src}
                    width="48"
                    height="48"
                    loading="lazy"
                    alt={english ? 'LIT official emblem' : '洛阳理工学院官方校徽'}
                  />
                </span>
                <div>
                  <h3>{text.lit}</h3>
                  <p>{text.litDegree}</p>
                </div>
              </article>
            </div>
          </div>

          <div class="about-block stack-block">
            <span class="section-kicker">{text.stackKicker}</span>
            <ul class="stack-list" aria-label={text.stackKicker}>
              {stackItems.map((item) => (
                <li class="stack-pill">
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
                  <span>{item.label}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </main>

      <footer class="portfolio-footer" id="contact" data-view="about">
        <div class="footer-card">
          <div class="sec-num">04 / CONTACT</div>
          <h2>{text.contact}</h2>
          <p class="contact-lead">{text.contactIntro}</p>

          <div class="contact-actions">
            <a class="contact-email" href="mailto:coder.yy521@gmail.com">
              coder.yy521@gmail.com <span aria-hidden="true">↗</span>
            </a>
            <button
              class="contact-pill-btn"
              type="button"
              data-copy-email
              data-copy-label={text.copy}
              data-copied-label={text.copied}
              data-error-label={text.copyError}
            >
              {text.copy}
            </button>

            <a
              class="contact-email contact-github"
              href="https://github.com/IT-coder-Yy"
              target="_blank"
              rel="noopener noreferrer"
            >
              github.com/IT-coder-Yy <span aria-hidden="true">↗</span>
            </a>
            <a
              class="contact-pill-btn"
              href="https://github.com/IT-coder-Yy"
              target="_blank"
              rel="noopener noreferrer"
            >
              {text.visitGithub}
            </a>
          </div>
          <p class="contact-status" aria-live="polite" data-copy-status></p>

          <div class="footer-bottom">
            <span>IT-Coder-Yy · 2026</span>
            <a href="#top">{text.backHome}</a>
          </div>
        </div>
      </footer>
    </div>

    <ProjectPreview locale={locale} />

    <script>
      import '../scripts/portfolio';
    </script>
  </body>
</html>
