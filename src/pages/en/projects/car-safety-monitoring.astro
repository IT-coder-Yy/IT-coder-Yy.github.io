---
import { sitePath } from '../../../lib/paths';
import SiteNav from '../../../components/SiteNav.astro';
import '../../../styles/home.css';
import '../../../styles/project-detail.css';
import '../../../styles/safety-detail.css';

const chapters = [
  ['Problem', 'problem'], ['Role', 'role'], ['Architecture', 'architecture'], ['Dual path', 'dual-path'],
  ['Decisions', 'decisions'], ['Boundaries', 'reliability'], ['Evidence', 'evidence'], ['Review', 'review'],
];
const workflow = [
  ['01', 'Visual input', 'Read driver imagery from a camera or local video into an OpenCV and Dlib landmark path.'],
  ['02', 'Fatigue assessment', 'Use eye and mouth aspect ratios, head pose and consecutive-frame statistics to form a more stable state.'],
  ['03', 'Cabin sensing', 'Read CO2, passive infrared and serial signals into the embedded task path.'],
  ['04', 'Task coordination', 'Use STM32 and RT-Thread Nano threads, semaphores and queues to coordinate acquisition, judgment, communication and reporting.'],
  ['05', 'Remote loop', 'Use CAT1 and MQTT to report state, receive cloud JSON commands and return threshold control to the local path.'],
  ['06', 'Safety state', 'Merge both paths into an in-cabin safety state for controlled local feedback and remote notification.'],
];
---

<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#f4f0e8" /><meta name="description" content="In-vehicle safety monitoring that combines fatigue vision with embedded cabin sensing." /><title>In-vehicle Safety Monitoring · Yu Yang</title></head>
  <body>
    <a class="skip-link" href="#detail-content">Skip to project details</a>
    <SiteNav locale="en" pathname="/en/projects/car-safety-monitoring" detail />
    <main id="detail-content" class="project-detail safety-detail">
      <section class="detail-hero safety-detail-hero" aria-labelledby="project-title">
        <div class="detail-hero-copy"><p class="detail-index">Project 04 / Computer Vision · Embedded IoT</p><h1 id="project-title">In-vehicle safety <em>monitoring</em></h1><p class="detail-lede">A dual safety loop that combines driver-fatigue vision with embedded cabin monitoring, from sensing and edge judgment through to cloud notification.</p><dl class="project-facts"><div><dt>Project type</dt><dd>Team project</dd></div><div><dt>My role</dt><dd>Fatigue-detection algorithms and the embedded / IoT path</dd></div><div><dt>Focus</dt><dd>OpenCV / Dlib · STM32 · RT-Thread · CAT1 / MQTT</dd></div></dl><div class="detail-actions"><a class="detail-primary" href="#dual-path">Explore the dual path <span aria-hidden="true">↓</span></a><a class="detail-quiet" href={sitePath('/en#projects')}>Back to projects <span aria-hidden="true">↑</span></a></div></div>
        <figure class="safety-hero-board" aria-labelledby="safety-hero-caption"><div class="safety-hero-path"><p>Vision assessment</p><span>Camera</span><i></i><span>Landmarks</span><i></i><span>Consecutive frames</span></div><div class="safety-hero-merge"><strong>In-cabin<br />safety state</strong><span>Local judgment / Remote notice</span></div><div class="safety-hero-path"><p>Cabin sensing</p><span>CO2 / PIR</span><i></i><span>RT-Thread</span><i></i><span>CAT1 / MQTT</span></div><figcaption id="safety-hero-caption">The abstract nodes explain the two system paths. They do not show real cabin imagery, sensor data or alerts.</figcaption></figure>
      </section>
      <div class="detail-body">
        <aside class="chapter-rail" aria-label="On-page sections"><p>Reading path</p><ol>{chapters.map(([label, id]) => <li><a href={'#' + id}>{label}</a></li>)}</ol></aside>
        <article class="detail-article">
          <section id="problem" class="detail-section"><p class="section-label">01 / Context</p><h2>A safety state should not depend on one frame or one sensor alone.</h2><p>Fatigue vision must deal with momentary expression, pose changes and individual differences. Cabin monitoring has its own acquisition, communication and threshold-management challenges. This project places consecutive-frame visual judgment beside embedded environmental state so both kinds of signal enter one traceable safety loop rather than producing unrelated prompts.</p></section>
          <section id="role" class="detail-section"><p class="section-label">02 / My role</p><div class="role-grid"><article><span>Fatigue vision</span><p>Contributed to eye, mouth and head-pose analysis based on facial landmarks, with consecutive-frame statistics for fatigue-state assessment.</p></article><article><span>Embedded tasks</span><p>Contributed to sensor acquisition, state judgment, thread coordination and serial communication on STM32 and RT-Thread Nano.</p></article><article><span>IoT loop</span><p>Contributed to CAT1 initialization, MQTT pub/sub, automatic reconnect, cloud JSON command parsing and threshold control.</p></article></div></section>
          <section id="architecture" class="detail-section architecture-section"><p class="section-label">03 / Architecture</p><h2>Let vision and cabin sensing judge independently, then meet at one safety state.</h2><p class="architecture-note">This path clarifies responsibilities and state convergence. It does not invent driver behavior, environment values, alert screenshots or remote message content.</p><ol class="workflow">{workflow.map(([index, title, description]) => <li><span>{index}</span><div><strong>{title}</strong><p>{description}</p></div></li>)}</ol><div class="architecture-footnote safety-footnote"><span>Vision</span><i></i><span>Landmarks / EAR / MAR / Head pose / Consecutive frames</span><span>Device</span><i></i><span>Sensors / RTOS tasks / CAT1 / MQTT</span></div></section>
          <section id="dual-path" class="detail-section dual-path-section"><p class="section-label">04 / Manual dual path</p><h2>Inspect how each path enters the same safety state.</h2><p>Choose the vision or cabin path to see its input, processing, state output and deployment boundary. The interaction explains the mechanism only; it does not connect to a camera, sensor, cloud service or vehicle data.</p><div class="dual-path-shell"><div class="dual-path-controls" role="group" aria-label="Choose a safety monitoring path"><p>Choose path</p><button type="button" class="is-active" data-safety-path="vision" aria-pressed="true">Vision assessment</button><button type="button" data-safety-path="device" aria-pressed="false">Cabin sensing</button></div><div class="dual-path-stage" data-safety-stage="vision" aria-live="polite"><div class="dual-path-diagram" aria-hidden="true"><div class="path-vision-node"><span>Camera</span><i></i><span>68 landmarks</span><i></i><span>EAR / MAR / Pose</span><i></i><span>Consecutive-frame state</span></div><div class="path-device-node"><span>CO2 / PIR</span><i></i><span>RT-Thread tasks</span><i></i><span>CAT1 / MQTT</span></div><div class="path-state-node"><strong>In-cabin safety state</strong><span data-safety-focus>Viewing: vision assessment</span></div></div><div class="dual-path-copy"><p data-safety-index>Path A / Vision assessment</p><h3 data-safety-title>Use a consecutive-frame state so one expression does not become a conclusion.</h3><dl><div><dt>Input</dt><dd data-safety-input>Driver imagery from a camera or local video.</dd></div><div><dt>Process</dt><dd data-safety-process>Compute EAR, MAR and head pose from 68 facial landmarks, then observe state changes across consecutive frames.</dd></div><div><dt>Output</dt><dd data-safety-output>A fatigue-related judgment entering the shared safety-state layer.</dd></div><div><dt>Boundary</dt><dd data-safety-boundary>Thresholds and individual differences need deployment calibration; this page infers no real driving behavior.</dd></div></dl></div></div><p class="dual-path-note">Nodes, state labels and connections are explanations of the system mechanism, not a live safety grade, cloud state or alert.</p></div></section>
          <section id="decisions" class="detail-section"><p class="section-label">05 / Key decisions</p><div class="decision-list"><article><p>Decision one</p><h3>Give EAR, MAR and pose different observation jobs.</h3><dl><div><dt>Problem</dt><dd>Eye closure, mouth opening and a lowered head are different signals; one feature cannot describe every visible sign of fatigue.</dd></div><div><dt>Choice</dt><dd>Compute eye aspect ratio, mouth aspect ratio and head pose separately from facial landmarks, then feed them into consecutive-frame statistics.</dd></div><div><dt>Boundary</dt><dd>These features support a judgment; thresholds, lighting, pose and individual differences remain real deployment conditions.</dd></div></dl></article><article><p>Decision two</p><h3>Put sustained state ahead of single-frame judgment.</h3><dl><div><dt>Problem</dt><dd>A blink, yawn or brief head turn can be an ordinary moment; direct alerts amplify false-positive risk.</dd></div><div><dt>Choice</dt><dd>Use consecutive-frame statistics so the vision path outputs a state transition, not an absolute verdict on one frame.</dd></div><div><dt>Boundary</dt><dd>The page explains structure and reports no unverified recognition rate, alert count or safety outcome.</dd></div></dl></article><article><p>Decision three</p><h3>Use RTOS coordination to bring cabin sensing into a remote loop.</h3><dl><div><dt>Problem</dt><dd>Sensor acquisition, state judgment, serial communication and network reporting have different execution rhythms.</dd></div><div><dt>Choice</dt><dd>RT-Thread Nano organizes threads, semaphores and message queues; CAT1 / MQTT handles report, subscription, reconnect and remote threshold instructions.</dd></div><div><dt>Boundary</dt><dd>Remote control returns to local parsing and threshold boundaries. No device identity, topic, address or message payload is exposed.</dd></div></dl></article></div></section>
          <section id="reliability" class="detail-section"><p class="section-label">06 / Reliability and boundaries</p><h2>Safety prompts must acknowledge sensing and deployment conditions.</h2><ul class="reliability-list"><li><strong>Consecutive-frame protection</strong><span>The vision side handles state transitions across frames instead of letting one expression decide the reminder.</span></li><li><strong>Task isolation</strong><span>Acquisition, judgment, communication and reporting coordinate through the RT-Thread task model rather than one blocking path.</span></li><li><strong>Communication recovery</strong><span>The CAT1 / MQTT path includes initialization, pub/sub and automatic reconnect; network availability is never treated as constant.</span></li><li><strong>Privacy and control</strong><span>The page exposes no face imagery, cabin measurements, device identity, cloud credential or remote command content.</span></li></ul></section>
          <section id="evidence" class="detail-section evidence-section"><p class="section-label">07 / Evidence</p><h2>The verifiable evidence is the dual-path composition and engineering role, not a polished alert demo.</h2><div class="evidence-ledger"><article><span>Vision module</span><p>The work includes OpenCV, Dlib 68-point landmarks, EAR, MAR, head pose, consecutive-frame statistics and adjustable parameters.</p></article><article><span>Embedded module</span><p>It includes STM32, RT-Thread Nano, CO2, PIR sensing, serial reception, threads, semaphores and message queues.</p></article><article><span>IoT path</span><p>It includes CAT1 initialization, MQTT pub/sub, automatic reconnect, cloud JSON command parsing and threshold control.</p></article></div></section>
          <section id="review" class="detail-section review-section"><p class="section-label">08 / Review and next step</p><p>The goal is not to let one vision model replace every safety judgment. It is to create a traceable state loop where vision, sensing, embedded tasks and communication can work together. A next step is de-identified replay evaluation across lighting, pose, environment and network conditions to calibrate thresholds and false-positive boundaries.</p><div class="detail-end-actions"><a href={sitePath('/en/projects/multi-channel-camera')}>Previous: Infrared camera <span aria-hidden="true">←</span></a><a href={sitePath('/en#projects')}>Back to projects <span aria-hidden="true">↑</span></a></div></section>
        </article>
      </div>
    </main>
    <script>
      const safetyStates = {
        vision: { index: 'Path A / Vision assessment', title: 'Use a consecutive-frame state so one expression does not become a conclusion.', input: 'Driver imagery from a camera or local video.', process: 'Compute EAR, MAR and head pose from 68 facial landmarks, then observe state changes across consecutive frames.', output: 'A fatigue-related judgment entering the shared safety-state layer.', boundary: 'Thresholds and individual differences need deployment calibration; this page infers no real driving behavior.', focus: 'Viewing: vision assessment' },
        device: { index: 'Path B / Cabin sensing', title: 'Let sensors, tasks and communication each run at an appropriate rhythm.', input: 'CO2, passive infrared and serial-reception data.', process: 'Use RT-Thread Nano threads, semaphores and message queues to organize acquisition, judgment, communication and reporting.', output: 'Cabin state and controlled remote feedback entering the shared safety-state layer.', boundary: 'Network exceptions, remote commands and threshold updates remain within local task and parsing boundaries; no real device data is shown.', focus: 'Viewing: cabin sensing' },
      };
      const controls = document.querySelectorAll('[data-safety-path]'); const stage = document.querySelector('[data-safety-stage]'); const index = document.querySelector('[data-safety-index]'); const title = document.querySelector('[data-safety-title]'); const input = document.querySelector('[data-safety-input]'); const process = document.querySelector('[data-safety-process]'); const output = document.querySelector('[data-safety-output]'); const boundary = document.querySelector('[data-safety-boundary]'); const focus = document.querySelector('[data-safety-focus]');
      function selectSafetyPath(key) { const state = safetyStates[key]; stage.dataset.safetyStage = key; index.textContent = state.index; title.textContent = state.title; input.textContent = state.input; process.textContent = state.process; output.textContent = state.output; boundary.textContent = state.boundary; focus.textContent = state.focus; controls.forEach((control) => { const selected = control.dataset.safetyPath === key; control.classList.toggle('is-active', selected); control.setAttribute('aria-pressed', String(selected)); }); }
      controls.forEach((control) => control.addEventListener('click', () => selectSafetyPath(control.dataset.safetyPath)));
    </script>
  </body>
</html>
