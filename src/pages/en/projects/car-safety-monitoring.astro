import '../../../styles/project-detail.css';
import '../../../styles/safety-detail.css';

const chapters = [
  ['Problem', 'problem'], ['Role', 'role'], ['Architecture', 'architecture'], ['Dual path', 'dual-path'],
  ['Decisions', 'decisions'], ['Boundaries', 'reliability'], ['Evidence', 'evidence'], ['Review', 'review'],
];
const workflow = [
  ['01', 'Facial landmark tracking', 'Capture driver video streams into an OpenCV and Dlib 68-point facial geometry extraction pipeline.'],
  ['02', 'Multi-feature temporal filtering', 'Jointly compute Eye Aspect Ratio (EAR), Mouth Aspect Ratio (MAR) and 3D head pose, applying consecutive-frame sliding statistics to reject transient motion noise.'],
  ['03', 'Multi-sensor cabin telemetry', 'Sample real-time cabin CO2 concentration and passive infrared (PIR) occupancy signals into the embedded sensing pipeline.'],
  ['04', 'RTOS multi-task scheduling', 'Orchestrate high-rate sensor polling, local safety arbitration and UART communication on STM32 and RT-Thread Nano using threads, semaphores and message queues.'],
  ['05', 'CAT1 / MQTT cloud loop', 'Report telemetry, handle automatic link recovery and parse cloud JSON commands via 4G CAT1 and MQTT to dynamically update local safety thresholds.'],
  ['06', 'Dual-path state convergence', 'Merge temporal visual fatigue states with embedded cabin telemetry at the safety decision layer to drive coordinated local alerts and remote notifications.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" /><meta name="theme-color" content="#f6f5f1" /><ThemeScript /><ClientRouter fallback="swap" /><meta name="description" content="In-vehicle safety monitoring system uniting 68-point temporal facial tracking with STM32/RT-Thread cabin sensing and CAT1/MQTT cloud telemetry." /><title>In-vehicle Safety Monitoring · IT-coder-Yy</title></head>
  <body>
    <a class="skip-link" href="#detail-content">Skip to project details</a>
    <SiteNav locale="en" pathname="/en/projects/car-safety-monitoring" detail />
    <main id="detail-content" class="project-detail safety-detail">
      <section class="detail-hero safety-detail-hero" aria-labelledby="project-title">
        <div class="detail-hero-copy"><p class="detail-index">Project 04 / Computer Vision · Embedded IoT</p><h1 id="project-title">In-vehicle safety <em>monitoring</em></h1><p class="detail-lede">Dual-path convergence of edge vision and embedded RTOS: uniting 68-point consecutive-frame facial tracking with STM32 / RT-Thread multi-sensor cabin telemetry to close the loop from edge arbitration to CAT1 / MQTT cloud synchronization.</p><div class="detail-actions"><a class="detail-primary" href="#dual-path">Explore the dual path <span aria-hidden="true">↓</span></a></div><dl class="project-facts"><div><dt>Project type</dt><dd>Automotive IoT team project</dd></div><div><dt>My role</dt><dd>Temporal fatigue vision, RT-Thread multitasking & MQTT cloud loop</dd></div><div><dt>Focus</dt><dd>OpenCV / Dlib · STM32 · RT-Thread · MQTT</dd></div></dl></div>
        <figure class="safety-hero-board" aria-labelledby="safety-hero-caption"><div class="safety-hero-path"><p>Vision assessment</p><span>Camera</span><i></i><span>Landmarks</span><i></i><span>Consecutive frames</span></div><div class="safety-hero-merge"><strong>In-cabin<br />safety state</strong><span>Local judgment / Remote notice</span></div><div class="safety-hero-path"><p>Cabin sensing</p><span>CO2 / PIR</span><i></i><span>RT-Thread</span><i></i><span>CAT1 / MQTT</span></div><figcaption id="safety-hero-caption">Architecture board showing how the consecutive-frame visual state machine and the RT-Thread embedded sensing pipeline converge at the edge and synchronize with the cloud.</figcaption></figure>
      </section>
      <section class="detail-film" aria-label="Project film">
        <ProjectVideo kind="safety" locale="en" />
      </section>

      <div class="detail-body">
        <aside class="chapter-rail" aria-label="On-page sections"><p>Reading path</p><ol>{chapters.map(([label, id]) => <li><a href={'#' + id}>{label}</a></li>)}</ol></aside>
        <article class="detail-article">
          <section id="problem" class="detail-section"><p class="section-label">01 / Context</p><h2>Temporal Statistics & Dual-Path Verification</h2><p class="section-subhead">— A single closed-eye frame might be a blink, and a single sensor spike might be noise.</p><p>Automotive safety spans both active driving (fatigue prevention) and stationary cabin protection (hypoxia and occupancy monitoring). On the vision side, shifting illumination, head turns and everyday actions like blinking or speaking easily trigger false alarms in single-frame classifiers. On the embedded side, polling CO2 and PIR sensors, arbitrating thresholds, handling UART streams and publishing over 4G cellular operate on vastly different timescales—stacking them in a bare-metal superloop means a single network stall freezes local sensing. This system runs a consecutive-frame visual state machine alongside an RT-Thread multitasking pipeline, converging heterogeneous signals inside a deterministic, fault-tolerant safety loop.</p></section>
          <section id="role" class="detail-section"><p class="section-label">02 / My role</p><div class="role-grid"><article><span>Temporal fatigue vision</span><p>Built the Dlib 68-landmark pipeline computing EAR, MAR and head pose, paired with consecutive-frame sliding statistics to suppress transient expression false alarms and a live GUI tuning panel.</p></article><article><span>RTOS embedded multitasking</span><p>Designed the STM32 and RT-Thread Nano multi-threaded architecture using semaphores and message queues to decouple CO2/PIR sensing, local state arbitration and UART communication.</p></article><article><span>CAT1 / MQTT cloud loop</span><p>Implemented 4G CAT1 modem initialization, MQTT pub/sub telemetry, automatic drop-recovery state machines and cloud JSON command parsing for live threshold updates.</p></article></div></section>
          <section id="architecture" class="detail-section architecture-section"><p class="section-label">03 / Architecture</p><h2>Edge Vision Meets Embedded RTOS</h2><p class="section-subhead">— Visual temporal pipelines and RT-Thread tasks evolve independently before converging at the safety layer.</p><p class="architecture-note">The architecture strictly separates compute-intensive facial geometry tracking from I/O-bound embedded sensing and cellular communication, uniting both paths through structured serial protocols and cloud message contracts.</p><ol class="workflow">{workflow.map(([index, title, description]) => <li><span>{index}</span><div><strong>{title}</strong><p>{description}</p></div></li>)}</ol><div class="architecture-footnote safety-footnote"><span>Vision</span><i></i><span>Landmarks / EAR / MAR / Head pose / Consecutive frames</span><span>Device</span><i></i><span>Sensors / RTOS tasks / CAT1 / MQTT</span></div></section>
          <section id="dual-path" class="detail-section dual-path-section"><p class="section-label">04 / Manual dual path</p><h2>Interactive Dual-Path Safety Kernel</h2><p class="section-subhead">— Switch between Vision Assessment and Cabin Sensing to inspect temporal filtering and RTOS scheduling.</p><p>Switch between the Vision Assessment and Cabin Sensing paths below to inspect each pipeline's signal inputs, core processing mechanics, state outputs and fault-tolerance boundaries.</p><div class="dual-path-shell"><div class="dual-path-controls" role="group" aria-label="Choose a safety monitoring path"><p>Choose path</p><button type="button" class="is-active" data-safety-path="vision" aria-pressed="true">Vision assessment</button><button type="button" data-safety-path="device" aria-pressed="false">Cabin sensing</button></div><div class="dual-path-stage" data-safety-stage="vision" aria-live="polite"><div class="dual-path-diagram" aria-hidden="true"><div class="path-vision-node"><span>Camera</span><i></i><span>68 landmarks</span><i></i><span>EAR / MAR / Pose</span><i></i><span>Consecutive-frame state</span></div><div class="path-device-node"><span>CO2 / PIR</span><i></i><span>RT-Thread tasks</span><i></i><span>CAT1 / MQTT</span></div><div class="path-state-node"><strong>In-cabin safety state</strong><span data-safety-focus>Viewing: vision assessment</span></div></div><div class="dual-path-copy"><p data-safety-index>Path A / Vision assessment</p><h3 data-safety-title>Multi-Feature Sliding Windows Eliminate False Alarms</h3><dl><div><dt>Input</dt><dd data-safety-input>Live cabin camera stream or local evaluation video frames.</dd></div><div><dt>Process</dt><dd data-safety-process>Jointly compute EAR, MAR and head pose from 68 facial landmarks, tracking sustained eye closure, yawning and head nodding across sliding frame windows.</dd></div><div><dt>Output</dt><dd data-safety-output>Temporally filtered, structured fatigue state grades entering the safety layer.</dd></div><div><dt>Boundary</dt><dd data-safety-boundary>Supports live GUI calibration of landmark thresholds and frame-window lengths to adapt across driver facial geometries and lighting shifts.</dd></div></dl></div></div><p class="dual-path-note">The dual-path diagram illustrates the real data flow and state convergence across the edge vision node, the STM32/RT-Thread controller and the MQTT cloud broker.</p></div></section>
          <section id="decisions" class="detail-section"><p class="section-label">05 / Key decisions</p><div class="decision-list"><article><p>Decision one</p><h3>Orthogonal Fusion of EAR, MAR & Pose</h3><dl><div><dt>Problem</dt><dd>Driver fatigue does not manifest as a single motion—micro-sleep eye closure, repeated yawning and distraction head-nodding exhibit distinct geometric signatures that any single feature will miss.</dd></div><div><dt>Choice</dt><dd>Extract Eye Aspect Ratio (EAR), Mouth Aspect Ratio (MAR) and 3D head pose simultaneously from 68 facial landmarks before feeding the combined vector into temporal counters.</dd></div><div><dt>Boundary</dt><dd>Decouples local facial deformation from rigid head rotation while exposing live calibration controls for rapid adaptation to camera mounting angles.</dd></div></dl></article><article><p>Decision two</p><h3>Consecutive-Frame State Over Single Thresholds</h3><dl><div><dt>Problem</dt><dd>Ordinary blinks, spoken words or brief mirror checks cross static geometric thresholds on individual frames; triggering immediate alerts destroys system usability with false positives.</dd></div><div><dt>Choice</dt><dd>Enforce a consecutive-frame state machine where fatigue state transitions occur only when anomalous geometric signatures persist across a configurable sliding window.</dd></div><div><dt>Boundary</dt><dd>Trades a sub-second temporal accumulation window for an order-of-magnitude reduction in false alarms, outputting stable physiological trends rather than brittle frame snapshots.</dd></div></dl></article><article><p>Decision three</p><h3>RT-Thread Multitasking & Self-Healing Cellular</h3><dl><div><dt>Problem</dt><dd>CO2/PIR sensor acquisition, UART framing and 4G CAT1 network I/O operate at vastly different latencies, while moving vehicles frequently suffer cellular handoff drops.</dd></div><div><dt>Choice</dt><dd>Port RT-Thread Nano to STM32 using threads, semaphores and message queues for asynchronous task isolation, paired with a self-healing CAT1/MQTT state machine and cloud JSON threshold parser.</dd></div><div><dt>Boundary</dt><dd>High-latency cellular I/O never blocks millisecond-level local sensor arbitration, and remote cloud threshold updates must pass local schema parsing before taking effect.</dd></div></dl></article></div></section>
          <section id="reliability" class="detail-section"><p class="section-label">06 / Reliability and boundaries</p><h2>Deterministic Response Under Field Jitter</h2><p class="section-subhead">— Temporal debouncing, RTOS task isolation, and self-healing cellular recovery under harsh cabin conditions.</p><ul class="reliability-list"><li><strong>Temporal debounce protection</strong><span>Sliding multi-frame statistics strip out transient facial expressions and pose spikes so every fatigue alert is backed by sustained time-series evidence.</span></li><li><strong>RTOS task isolation</strong><span>Preemptive RT-Thread scheduling, semaphore synchronization and message queues cleanly isolate sensor polling and UART parsing from high-latency cellular I/O.</span></li><li><strong>Self-healing cellular recovery</strong><span>The CAT1 / MQTT stack embeds link supervision and automatic reconnection, keeping local cabin monitoring and hardware alerts fully operational during network blackouts.</span></li><li><strong>Governed bidirectional contracts</strong><span>Remote cloud configurations arrive as structured JSON payloads and pass local boundary validation before dynamically updating CO2 and safety thresholds.</span></li></ul></section>
          <section id="evidence" class="detail-section evidence-section"><p class="section-label">07 / Evidence</p><h2>End-to-End Vision, RTOS & IoT Delivery</h2><p class="section-subhead">— Complete implementation across 68-landmark GUI tuning, STM32/RT-Thread firmware, and MQTT cloud sync.</p><div class="evidence-ledger"><article><span>Vision sensing & tuning module</span><p>Implemented the OpenCV capture pipeline, Dlib 68-point landmark tracking, joint EAR/MAR/pose calculation, consecutive-frame state machine and live GUI parameter tuning panel.</p></article><article><span>STM32 & RTOS kernel module</span><p>Implemented STM32 peripheral drivers, RT-Thread Nano multi-threading, semaphore and message-queue IPC, CO2 and PIR sensor acquisition and cross-board UART protocols.</p></article><article><span>CAT1 & MQTT cloud-edge loop</span><p>Implemented 4G CAT1 modem AT initialization, MQTT pub/sub telemetry, automatic drop reconnection and cloud JSON command parsing for live threshold updates.</p></article></div></section>
          <section id="review" class="detail-section review-section"><p class="section-label">08 / Review and next step</p><p>The core engineering takeaway from this project is moving beyond the trap of treating an isolated vision model as a complete safety product. By pairing consecutive-frame visual state tracking with STM32 / RT-Thread real-time multitasking and self-healing CAT1 / MQTT telemetry, the system turns noisy physical inputs into a traceable, dual-path safety loop. Whether filtering transient blinks with temporal windows on the vision side or isolating cellular jitter with RTOS message queues on the embedded side, the architecture uses deterministic system design to tame real-world uncertainty.</p><div class="detail-end-actions"><a href={sitePath('/en/projects/multi-channel-camera')}>Previous: Infrared camera <span aria-hidden="true">←</span></a><a href={sitePath('/en#projects')}>Back to projects <span aria-hidden="true">↑</span></a></div></section>
        </article>
      </div>
    </main>
    <script>
    import { onPageLoad } from '../../../lib/page-lifecycle';
    onPageLoad((signal) => {
      if(document.documentElement.lang.startsWith('en') !== true) return;
      const safetyStates = {
        vision: { index: 'Path A / Vision assessment', title: 'Multi-Feature Sliding Windows Eliminate False Alarms', input: 'Live cabin camera stream or local evaluation video frames.', process: 'Jointly compute EAR, MAR and head pose from 68 facial landmarks, tracking sustained eye closure, yawning and head nodding across sliding frame windows.', output: 'Temporally filtered, structured fatigue state grades entering the safety layer.', boundary: 'Supports live GUI calibration of landmark thresholds and frame-window lengths to adapt across driver facial geometries and lighting shifts.', focus: 'Viewing: vision assessment' },
        device: { index: 'Path B / Cabin sensing', title: 'RT-Thread Queues Decouple Sensing and Telemetry', input: 'CO2 concentration sensors, passive infrared (PIR) occupancy signals and cross-board UART frames.', process: 'Orchestrate high-rate polling and threshold arbitration via RT-Thread Nano threads, semaphores and queues while maintaining bidirectional sync over CAT1 / MQTT.', output: 'Cabin environmental safety state, local hardware responses and cloud telemetry packets.', boundary: 'Includes a self-healing CAT1 reconnect state machine and JSON command validation so local protection runs uninterrupted during cellular dropouts.', focus: 'Viewing: cabin sensing' },
      };
      const controls = document.querySelectorAll('[data-safety-path]'); const stage = document.querySelector('[data-safety-stage]'); const index = document.querySelector('[data-safety-index]'); const title = document.querySelector('[data-safety-title]'); const input = document.querySelector('[data-safety-input]'); const process = document.querySelector('[data-safety-process]'); const output = document.querySelector('[data-safety-output]'); const boundary = document.querySelector('[data-safety-boundary]'); const focus = document.querySelector('[data-safety-focus]');
      function selectSafetyPath(key) { const state = safetyStates[key]; stage.dataset.safetyStage = key; index.textContent = state.index; title.textContent = state.title; input.textContent = state.input; process.textContent = state.process; output.textContent = state.output; boundary.textContent = state.boundary; focus.textContent = state.focus; controls.forEach((control) => { const selected = control.dataset.safetyPath === key; control.classList.toggle('is-active', selected); control.setAttribute('aria-pressed', String(selected)); }); }
      controls.forEach((control) => control.addEventListener('click', () => selectSafetyPath(control.dataset.safetyPath)));

    });
  </script>
  </body>
</html>
