---
import { ClientRouter } from 'astro:transitions';
import ThemeScript from '../../../components/ThemeScript.astro';
import ProjectVideo from '../../../components/ProjectVideo.astro';
import { sitePath } from '../../../lib/paths';
import SiteNav from '../../../components/SiteNav.astro';
import '../../../styles/home.css';
import '../../../styles/project-detail.css';
import '../../../styles/camera-detail.css';

const chapters = [
  ['Problem', 'problem'], ['Role', 'role'], ['Architecture', 'architecture'], ['Processing', 'processing'],
  ['Decisions', 'decisions'], ['Boundaries', 'reliability'], ['Evidence', 'evidence'], ['Review', 'review'],
];
const workflow = [
  ['01', 'Concurrent multi-source ingest', 'Unify industrial camera SDKs, RTSP feeds and custom raw byte streams into one managed C++/Qt acquisition pipeline.'],
  ['02', '16-bit radiometric recovery', 'Parse custom headers and packet payloads to reconstruct lossless 16-bit infrared matrices instead of settling for 8-bit display streams.'],
  ['03', 'Percentile normalization & ROI proposal', 'Combine dynamic-range percentile clipping, ViBe background modeling, frame differencing and morphology to isolate subtle gas-plume candidates.'],
  ['04', 'Dual-engine async inference', 'Dispatch ONNX Runtime (YOLOv8) and MNN inference on isolated worker threads, returning structured detections via Qt signals and slots.'],
  ['05', 'High-throughput I/O & hardware control', 'Absorb high-rate raw recording spikes with bounded queues and batch flushes while closing the loop with PTZ, TEC and register control.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" /><meta name="theme-color" content="#f6f5f1" /><ThemeScript /><ClientRouter fallback="swap" /><meta name="description" content="Multi-channel infrared camera and gas-leak detection: an industrial C++/Qt vision workstation featuring multi-source ingest, 16-bit radiometric preservation and asynchronous inference." /><title>Multi-channel Infrared Camera · IT-coder-Yy</title></head>
  <body>
    <a class="skip-link" href="#detail-content">Skip to project details</a>
    <SiteNav locale="en" pathname="/en/projects/multi-channel-camera" detail />
    <main id="detail-content" class="project-detail camera-detail">
      <section class="detail-hero camera-detail-hero" aria-labelledby="project-title">
        <div class="detail-hero-copy"><p class="detail-index">Project 03 / Computer Vision · C++</p><h1 id="project-title">Multi-channel infrared camera and <em>leak detection</em></h1><p class="detail-lede">From 16-bit raw infrared streams to real-time leak capture: an industrial C++/Qt vision workstation engineered for concurrent multi-source ingest, radiometric dynamic-range preservation, asynchronous inference and high-throughput disk recording.</p><div class="detail-actions"><a class="detail-primary" href="#processing">Explore processing <span aria-hidden="true">↓</span></a></div><dl class="project-facts"><div><dt>Project type</dt><dd>Industrial vision team project</dd></div><div><dt>My role</dt><dd>C++/Qt multi-source pipeline, 16-bit algorithms & async inference</dd></div><div><dt>Focus</dt><dd>C++ / Qt · 16-bit Infrared · ONNX · MNN</dd></div></dl></div>
        <figure class="camera-hero-plate" aria-labelledby="camera-hero-caption"><div class="camera-plate-ruler"><span>Multi-source input</span><span>16-bit image path</span><span>System output</span></div><div class="camera-signal-grid" aria-hidden="true">{Array.from({ length: 16 }).map(() => <span></span>)}</div><div class="camera-plate-flow"><span>Raw frame</span><i></i><span>Normalize</span><i></i><span>Process</span><i></i><span>Deploy</span></div><figcaption id="camera-hero-caption">Signal plate illustrating the end-to-end processing cascade from 16-bit radiometric ingest and percentile normalization to background subtraction and asynchronous deployment.</figcaption></figure>
      </section>
      <section class="detail-film" aria-label="Project film">
        <ProjectVideo kind="camera" locale="en" />
      </section>

      <div class="detail-body">
        <aside class="chapter-rail" aria-label="On-page sections"><p>Reading path</p><ol>{chapters.map(([label, id]) => <li><a href={'#' + id}>{label}</a></li>)}</ol></aside>
        <article class="detail-article">
          <section id="problem" class="detail-section"><p class="section-label">01 / Context</p><h2>16-Bit Fidelity Under High-Throughput Streams</h2><p class="section-subhead">— Single-frame detection is just the start; the real battle is zero-blocking UI and raw disk I/O under concurrent stream load.</p><p>In industrial environments, gas leaks often manifest as faint thermal gradients. Feeding standard 8-bit display-compressed streams into an algorithm risks quantizing away subtle plume signatures before detection even begins. Meanwhile, ingesting multi-channel 16-bit raw streams alongside RTSP feeds creates fierce contention across decoding, image processing, deep-learning inference and continuous raw recording. A standalone model script does not survive the field—the system requires strict thread isolation, bounded memory queues and deterministic data paths.</p></section>
          <section id="role" class="detail-section"><p class="section-label">02 / My role</p><div class="role-grid"><article><span>Image processing & ROI pipeline</span><p>Engineered 16-bit dynamic-range handling, percentile clipping, ViBe background modeling, frame differencing and morphological filtering to build an interpretable front-end pipeline.</p></article><article><span>C++/Qt workstation & video paths</span><p>Built the multi-page Qt desktop workstation uniting industrial camera SDKs, RTSP streams, custom raw packet assembly and hardware control (PTZ, TEC and device registers).</p></article><article><span>Dual-engine inference & concurrency</span><p>Integrated ONNX Runtime and MNN inference pipelines using QThread worker isolation, asynchronous signals/slots and bounded I/O queues so heavy workloads never stall capture or UI.</p></article></div></section>
          <section id="architecture" class="detail-section architecture-section"><p class="section-label">03 / Architecture</p><h2>Five-Stage Pipeline with Strict Thread Isolation</h2><p class="section-subhead">— From raw byte packets to hardware control, every stage enforces explicit memory bounds and async exits.</p><p class="architecture-note">The architecture decouples high-bandwidth streams into five deterministic stages—ingest & frame assembly, radiometric transformation, temporal motion priors, asynchronous neural inference and device control—ensuring heavy loads never cascade into system stalls.</p><ol class="workflow">{workflow.map(([index, title, description]) => <li><span>{index}</span><div><strong>{title}</strong><p>{description}</p></div></li>)}</ol><div class="architecture-footnote camera-footnote"><span>Acquisition</span><i></i><span>Industrial camera / RTSP / Raw stream</span><span>Engineering</span><i></i><span>Qt UI / Threading / Recording / Device control</span></div></section>
          <section id="processing" class="detail-section camera-processing-section"><p class="section-label">04 / Manual processing path</p><h2>Interactive Six-Stage Infrared Pipeline</h2><p class="section-subhead">— Step through each layer to see how 16-bit radiometric detail and temporal priors drive real-time detection.</p><p>Gas plumes exhibit low thermal contrast and non-rigid dispersion. Step through the pipeline below to see how the workstation preserves 16-bit radiometric detail while pairing interpretable temporal priors with asynchronous deep-learning inference.</p><div class="processing-shell"><div class="processing-controls" role="group" aria-label="Choose an infrared processing stage"><p>Processing stage</p><button type="button" class="is-active" data-process="raw" aria-pressed="true"><span>01</span>Raw 16-bit frame</button><button type="button" data-process="normalize" aria-pressed="false"><span>02</span>Normalize</button><button type="button" data-process="background" aria-pressed="false"><span>03</span>Background model</button><button type="button" data-process="candidate" aria-pressed="false"><span>04</span>Candidate regions</button><button type="button" data-process="inference" aria-pressed="false"><span>05</span>Model inference</button><button type="button" data-process="alert" aria-pressed="false"><span>06</span>Desktop feedback</button></div><div class="processing-stage" data-processing-stage="raw" aria-live="polite"><div class="abstract-frame" aria-hidden="true"><div class="abstract-frame-axis"><span>Low</span><span>Raw intensity</span><span>High</span></div><div class="abstract-frame-columns">{Array.from({ length: 12 }).map(() => <i></i>)}</div><div class="abstract-frame-caption"><span>Illustrative signal</span><span data-process-graphic>Preserve 16-bit radiometric levels</span></div></div><div class="processing-copy"><p data-process-index>Stage 01</p><h3 data-process-title>Lossless 16-Bit Radiometric Frame Recovery</h3><dl><div><dt>Input</dt><dd data-process-input>Industrial camera SDK packets or custom RTSP raw byte streams.</dd></div><div><dt>Goal</dt><dd data-process-goal>Parse custom frame headers and pixel payloads to preserve full 16-bit thermal intensity gradients.</dd></div><div><dt>Output</dt><dd data-process-output>Memory-aligned 16-bit raw infrared matrices.</dd></div><div><dt>Boundary</dt><dd data-process-constraint>Never feed 8-bit display-compressed frames into the algorithm pipeline, preventing subtle thermal gradients from being crushed by hardware AGC.</dd></div></dl></div></div><p class="processing-note">The interactive stages above reflect the six core C++ processing operators and thread handoffs inside the workstation.</p></div></section>
          <section id="decisions" class="detail-section"><p class="section-label">05 / Key decisions</p><div class="decision-list"><article><p>Decision one</p><h3>Preserve the 16-Bit Radiometric Data Path</h3><dl><div><dt>Problem</dt><dd>Industrial thermal scenes span wide temperature extremes; standard 8-bit RTSP streams undergo fixed mapping or aggressive AGC that erases subtle gas-leak gradients.</dd></div><div><dt>Choice</dt><dd>Parse low-level packet headers to recover full 16-bit matrices, applying percentile clipping and dynamic-range mapping in the radiometric domain while branching paths for display, detection and lossless storage.</dd></div><div><dt>Boundary</dt><dd>Balances full radiometric precision with operator usability: raw streams feed archival and feature extraction while normalized views serve real-time visual monitoring.</dd></div></dl></article><article><p>Decision two</p><h3>Pair Temporal Priors with Neural Inference</h3><dl><div><dt>Problem</dt><dd>Gas plumes are diffuse and non-rigid; relying solely on single-frame neural detectors against complex industrial piping invites false alarms from cyclical heat sources and makes debugging opaque.</dd></div><div><dt>Choice</dt><dd>Chain ViBe background modeling, frame differencing, adaptive thresholding and morphology to extract motion candidates before coordinating with ONNX Runtime and MNN inference.</dd></div><div><dt>Boundary</dt><dd>Classical operators provide transparent pixel-level change evidence while neural models confirm high-level semantics, giving engineers clear physical tuning knobs in the field.</dd></div></dl></article><article><p>Decision three</p><h3>Decouple Capture, Inference, and Disk I/O</h3><dl><div><dt>Problem</dt><dd>Running high-frame-rate multi-source capture, neural forward passes and continuous 16-bit raw disk writes on shared execution paths causes UI freezes and packet drops.</dd></div><div><dt>Choice</dt><dd>Isolate asynchronous inference via QThread and Qt signals/slots, and govern multi-source recording and raw disk writes with bounded memory queues and batched flushes.</dd></div><div><dt>Boundary</dt><dd>Trades unbounded buffering for deterministic memory ceilings, keeping live capture and operator controls responsive even during transient disk I/O stalls.</dd></div></dl></article></div></section>
          <section id="reliability" class="detail-section"><p class="section-label">06 / Reliability and boundaries</p><h2>Engineered for Continuous Field Operation</h2><p class="section-subhead">— Multi-protocol ingest, QThread worker isolation, bounded recording queues, and closed-loop hardware control.</p><ul class="reliability-list"><li><strong>Multi-source protocol adaptation</strong><span>Unifies industrial camera SDKs, RTSP streams, custom raw packet assembly and device control protocols behind clean C++ acquisition interfaces.</span></li><li><strong>Thread-level asynchronous isolation</strong><span>Capture, preprocessing, ONNX/MNN inference, UI rendering and disk writing run on decoupled threads, exchanging lightweight state via Qt signals and slots.</span></li><li><strong>High-throughput recording governance</strong><span>Snapshots, multi-stream recording and continuous 16-bit raw dumps use bounded queues and batch flushing to smooth out high-rate I/O spikes.</span></li><li><strong>Hardware control-plane closure</strong><span>Integrates device discovery, low-level register R/W, PTZ turret steering, TEC thermal regulation and parameter delivery into a unified sense-analyze-act loop.</span></li></ul></section>
          <section id="evidence" class="detail-section evidence-section"><p class="section-label">07 / Evidence</p><h2>Modular C++/Qt Industrial Vision Workstation</h2><p class="section-subhead">— End-to-end delivery uniting raw frame assembly, dual inference engines, and hardware control planes.</p><div class="evidence-ledger"><article><span>Multi-source ingest & frame assembly</span><p>Implemented RTSP streaming, custom raw header parsing, 16-bit frame reconstruction, camera discovery, packet reception and frame-assembly state machines.</p></article><article><span>Vision pipeline & dual inference engines</span><p>Implemented 16-bit percentile normalization, ViBe background modeling, morphological filtering and dual C++ inference paths across ONNX Runtime (YOLOv8) and MNN.</p></article><article><span>Qt workstation & system control</span><p>Implemented multi-page Qt UI, multi-threaded signal/slot orchestration, bounded-queue raw recording, PTZ/TEC/register control and a modular CMake build system.</p></article></div></section>
          <section id="review" class="detail-section review-section"><p class="section-label">08 / Review and next step</p><p>The biggest engineering takeaway from this system is that field value in industrial computer vision rarely hinges on squeezing an extra point of benchmark mAP out of an isolated model. It depends on whether 16-bit radiometric data arrives intact, whether asynchronous inference runs without blocking capture, and whether high-rate disk I/O stays within memory bounds. Only when low-level ingest, C++ concurrency, memory governance and hardware control are engineered as one cohesive pipeline does an algorithm truly work in the field.</p><div class="detail-end-actions"><a href={sitePath('/en/projects/freight-decision-agent')}>Previous: Freight decision <span aria-hidden="true">←</span></a><a href={sitePath('/en#projects')}>Back to projects <span aria-hidden="true">↑</span></a></div></section>
        </article>
      </div>
    </main>
    <script>
    import { onPageLoad } from '../../../lib/page-lifecycle';
    onPageLoad((signal) => {
      if(document.documentElement.lang.startsWith('en') !== true) return;
      const processStates = {
        raw: { index: 'Stage 01', title: 'Lossless 16-Bit Radiometric Frame Recovery', input: 'Industrial camera SDK packets or custom RTSP raw byte streams.', goal: 'Parse custom frame headers and pixel payloads to preserve full 16-bit thermal intensity gradients.', output: 'Memory-aligned 16-bit raw infrared matrices.', constraint: 'Never feed 8-bit display-compressed frames into the algorithm pipeline, preventing subtle thermal gradients from being crushed by hardware AGC.', graphic: 'Preserve 16-bit radiometric levels' },
        normalize: { index: 'Stage 02', title: 'Percentile Clipping & Dynamic-Range Mapping', input: 'Reconstructed 16-bit raw infrared matrices.', goal: 'Clip high-temperature outliers by percentile and map the target thermal band into a stable working range.', output: 'High-contrast normalized working views alongside an untouched 16-bit raw bypass.', constraint: 'Normalization serves visual inspection and feature extraction without overwriting the underlying 16-bit recording path.', graphic: 'Percentile clipping & range convergence' },
        background: { index: 'Stage 03', title: 'ViBe Background Modeling for Thermal Drift', input: 'Range-converged sequential infrared working frames.', goal: 'Maintain pixel-wise background sample models to decouple steady industrial pipe heat from sudden gas-leak plumes.', output: 'Continuously updated background baselines and foreground difference masks.', constraint: 'Update rates must be tightly governed so slow-drifting gas plumes are not absorbed into the static background.', graphic: 'Maintain adaptive thermal baseline' },
        candidate: { index: 'Stage 04', title: 'Frame Differencing & Morphological ROI Filtering', input: 'Foreground difference masks and multi-frame temporal motion signals.', goal: 'Eliminate sensor shot noise via adaptive thresholding and open/close morphology to aggregate contiguous plume regions.', output: 'Structured candidate regions (ROIs) and interpretable motion priors.', constraint: 'Front-end operators must maintain a minimal CPU footprint to act as a fast gatekeeper for neural inference.', graphic: 'Aggregate ROIs & strip shot noise' },
        inference: { index: 'Stage 05', title: 'Isolated Dual-Engine Asynchronous Inference', input: 'Preprocessed feature maps and candidate region context.', goal: 'Execute C++ YOLOv8 (ONNX Runtime) and MNN inference pipelines, returning structured detections asynchronously via Qt signals.', output: 'Structured detection results with spatial coordinates and confidence scores.', constraint: 'Inference threads are strictly isolated from capture and UI rendering so latency spikes never drop frames or freeze controls.', graphic: 'Dual-engine async inference' },
        alert: { index: 'Stage 06', title: 'Multi-View UI, Batch I/O & Hardware Control', input: 'Asynchronous inference outputs, 16-bit raw streams and device telemetry.', goal: 'Update multi-view UI overlays, flush bounded recording queues to disk and coordinate PTZ turrets and TEC thermal controllers.', output: 'Live operator feedback, lossless raw recordings and hardware control commands.', constraint: 'Disk writes are governed by bounded memory queues and batch flushes so sustained high-rate recording never exhausts RAM.', graphic: 'UI overlay, batch I/O & hardware control' },
      };
      const controls = document.querySelectorAll('[data-process]'); const stage = document.querySelector('[data-processing-stage]'); const index = document.querySelector('[data-process-index]'); const title = document.querySelector('[data-process-title]'); const input = document.querySelector('[data-process-input]'); const goal = document.querySelector('[data-process-goal]'); const output = document.querySelector('[data-process-output]'); const constraint = document.querySelector('[data-process-constraint]'); const graphic = document.querySelector('[data-process-graphic]');
      function selectProcess(key) { const state = processStates[key]; stage.dataset.processingStage = key; index.textContent = state.index; title.textContent = state.title; input.textContent = state.input; goal.textContent = state.goal; output.textContent = state.output; constraint.textContent = state.constraint; graphic.textContent = state.graphic; controls.forEach((control) => { const selected = control.dataset.process === key; control.classList.toggle('is-active', selected); control.setAttribute('aria-pressed', String(selected)); }); }
      controls.forEach((control) => control.addEventListener('click', () => selectProcess(control.dataset.process)));

    });
  </script>
  </body>
</html>
