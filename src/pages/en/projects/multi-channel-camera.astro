---
import { ClientRouter } from 'astro:transitions';
import ProjectVideo from '../../../components/ProjectVideo.astro';
import { sitePath } from '../../../lib/paths';
import SiteNav from '../../../components/SiteNav.astro';
import '../../../styles/home.css';
import '../../../styles/project-detail.css';
import '../../../styles/camera-detail.css';

const chapters = [
  ['Problem', 'problem'], ['Role', 'role'], ['Architecture', 'architecture'], ['Processing', 'processing'],
  ['Decisions', 'decisions'], ['Boundaries', 'reliability'], ['Evidence', 'evidence'], ['Review', 'review'],
];
const workflow = [
  ['01', 'Unify acquisition', 'Bring industrial cameras, RTSP and custom raw streams into one desktop application with managed multi-source input.'],
  ['02', 'Recover infrared frames', 'Parse raw headers and packets to restore 16-bit infrared images instead of retaining only display-oriented frames.'],
  ['03', 'Process and propose', 'Use dynamic-range handling, percentile clipping, differencing, thresholds, morphology and ViBe to form interpretable candidate information.'],
  ['04', 'Deploy inference', 'Run model paths through ONNX Runtime and MNN, then return structured feedback to the desktop application.'],
  ['05', 'Record and control', 'Keep display, recording, raw-data writing and device control inside one industrial monitoring loop.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <ClientRouter fallback="swap" /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" /><meta name="theme-color" content="#f4f0e8" /><meta name="description" content="Multi-channel infrared camera and gas-leak detection: a Windows Qt industrial monitoring system." /><title>Multi-channel Infrared Camera · Yu Yang</title></head>
  <body>
    <a class="skip-link" href="#detail-content">Skip to project details</a>
    <SiteNav locale="en" pathname="/en/projects/multi-channel-camera" detail />
    <main id="detail-content" class="project-detail camera-detail">
      <section class="detail-hero camera-detail-hero" aria-labelledby="project-title">
        <div class="detail-hero-copy"><p class="detail-index">Project 03 / Computer Vision · C++</p><h1 id="project-title">Multi-channel infrared camera and <em>leak detection</em></h1><p class="detail-lede">A Windows Qt desktop application for industrial multi-source infrared monitoring, bringing acquisition, display, recording, device control, image processing and model inference into one engineering loop.</p><dl class="project-facts"><div><dt>Project type</dt><dd>Team project</dd></div><div><dt>My role</dt><dd>Vision algorithms, C++ / Qt desktop software, multi-source video paths and inference deployment</dd></div><div><dt>Focus</dt><dd>C++ / Qt · 16-bit infrared · ONNX Runtime · MNN</dd></div></dl><div class="detail-actions"><a class="detail-primary" href="#processing">Explore processing <span aria-hidden="true">↓</span></a><a class="detail-quiet" href={sitePath('/en#projects')}>Back to projects <span aria-hidden="true">↑</span></a></div></div>
        <figure class="camera-hero-plate" aria-labelledby="camera-hero-caption"><div class="camera-plate-ruler"><span>Multi-source input</span><span>16-bit image path</span><span>System output</span></div><div class="camera-signal-grid" aria-hidden="true">{Array.from({ length: 16 }).map(() => <span></span>)}</div><div class="camera-plate-flow"><span>Raw frame</span><i></i><span>Normalize</span><i></i><span>Process</span><i></i><span>Deploy</span></div><figcaption id="camera-hero-caption">This abstract signal plate describes processing stages only. It is not a real field frame or a detection result.</figcaption></figure>
      </section>
      <section class="detail-film" aria-label="Project film">
        <ProjectVideo kind="camera" locale="en" />
      </section>

      <div class="detail-body">
        <aside class="chapter-rail" aria-label="On-page sections"><p>Reading path</p><ol>{chapters.map(([label, id]) => <li><a href={'#' + id}>{label}</a></li>)}</ol></aside>
        <article class="detail-article">
          <section id="problem" class="detail-section"><p class="section-label">01 / Context</p><h2>Seeing infrared imagery is only the start; the data, algorithms and devices have to work together.</h2><p>Industrial work rarely arrives through one camera or one frame format. The application has to receive industrial cameras, RTSP and raw streams, preserve 16-bit information, and still support display, processing, inference, recording and control. Making one algorithm run is not the same as delivering a usable system.</p></section>
          <section id="role" class="detail-section"><p class="section-label">02 / My role</p><div class="role-grid"><article><span>Image processing</span><p>Contributed to dynamic-range handling, percentile clipping, background modelling, thresholding and morphology for 16-bit infrared images.</p></article><article><span>Desktop application and video paths</span><p>Contributed to the C++ / Qt application and the engineering connection of industrial-camera, RTSP and raw-frame inputs.</p></article><article><span>Inference deployment</span><p>Contributed to ONNX Runtime and MNN paths, with QThread-based asynchronous return so inference does not block acquisition or UI.</p></article></div></section>
          <section id="architecture" class="detail-section architecture-section"><p class="section-label">03 / Architecture</p><h2>From a multi-source frame to desktop feedback, every stage needs an engineering exit.</h2><p class="architecture-note">This is a static description of roles and data flow. It does not expose field images, account data, device addresses or detection boxes.</p><ol class="workflow">{workflow.map(([index, title, description]) => <li><span>{index}</span><div><strong>{title}</strong><p>{description}</p></div></li>)}</ol><div class="architecture-footnote camera-footnote"><span>Acquisition</span><i></i><span>Industrial camera / RTSP / Raw stream</span><span>Engineering</span><i></i><span>Qt UI / Threading / Recording / Device control</span></div></section>
          <section id="processing" class="detail-section camera-processing-section"><p class="section-label">04 / Manual processing path</p><h2>Inspect one stage at a time and see what information it protects.</h2><p>This interaction follows the real processing order at a conceptual level. It shows input, objective, output and engineering constraints without connecting to field frames or generating a fictional leak region.</p><div class="processing-shell"><div class="processing-controls" role="group" aria-label="Choose an infrared processing stage"><p>Processing stage</p><button type="button" class="is-active" data-process="raw" aria-pressed="true"><span>01</span>Raw 16-bit frame</button><button type="button" data-process="normalize" aria-pressed="false"><span>02</span>Normalize</button><button type="button" data-process="background" aria-pressed="false"><span>03</span>Background model</button><button type="button" data-process="candidate" aria-pressed="false"><span>04</span>Candidate regions</button><button type="button" data-process="inference" aria-pressed="false"><span>05</span>Model inference</button><button type="button" data-process="alert" aria-pressed="false"><span>06</span>Desktop feedback</button></div><div class="processing-stage" data-processing-stage="raw" aria-live="polite"><div class="abstract-frame" aria-hidden="true"><div class="abstract-frame-axis"><span>Low</span><span>Raw intensity</span><span>High</span></div><div class="abstract-frame-columns">{Array.from({ length: 12 }).map(() => <i></i>)}</div><div class="abstract-frame-caption"><span>Illustrative signal</span><span data-process-graphic>Preserve raw intensity levels</span></div></div><div class="processing-copy"><p data-process-index>Stage 01</p><h3 data-process-title>Recover 16-bit infrared information from the raw stream.</h3><dl><div><dt>Input</dt><dd data-process-input>Raw RTSP stream or industrial-camera frames.</dd></div><div><dt>Goal</dt><dd data-process-goal>Parse frame structure and retain intensity information for both display and algorithms.</dd></div><div><dt>Output</dt><dd data-process-output>16-bit infrared image data for later stages.</dd></div><div><dt>Boundary</dt><dd data-process-constraint>Do not mistake a display-oriented image for the algorithm input.</dd></div></dl></div></div><p class="processing-note">All visuals are abstract signals. They do not represent a device, a test run or a gas-leak result.</p></div></section>
          <section id="decisions" class="detail-section"><p class="section-label">05 / Key decisions</p><div class="decision-list"><article><p>Decision one</p><h3>Preserve a 16-bit data path instead of only optimizing a good-looking image.</h3><dl><div><dt>Problem</dt><dd>RTSP raw streams, industrial cameras and display images have different formats; early compression or fixed mapping can discard useful intensity information.</dd></div><div><dt>Choice</dt><dd>Recover 16-bit data from raw frames and use dynamic-range handling with percentile clipping for both visualization and processing.</dd></div><div><dt>Boundary</dt><dd>The page explains the processing principle without exposing field frames, camera parameters or identifiable device context.</dd></div></dl></article><article><p>Decision two</p><h3>Build an interpretable candidate path instead of leaving all judgment to a black box.</h3><dl><div><dt>Problem</dt><dd>Infrared scenes are affected by dynamic range, changing backgrounds and noise; one model output is difficult to review in context.</dd></div><div><dt>Choice</dt><dd>ViBe, differencing, thresholding and morphology organize candidate information before deployment inference works alongside it.</dd></div><div><dt>Boundary</dt><dd>Candidate information is an internal processing state, not a fabricated detection box, leak location or accuracy claim.</dd></div></dl></article><article><p>Decision three</p><h3>Separate acquisition, inference, UI and writing to protect field responsiveness.</h3><dl><div><dt>Problem</dt><dd>High-rate frames, inference and raw-data writes compete for time; blocking one can delay the UI and capture path.</dd></div><div><dt>Choice</dt><dd>QThread and signals/slots organize asynchronous inference, while bounded queues and batch flushes manage recording pressure.</dd></div><div><dt>Boundary</dt><dd>Queue governance keeps the system controllable; it is not presented as an unverified throughput or frame-rate result.</dd></div></dl></article></div></section>
          <section id="reliability" class="detail-section"><p class="section-label">06 / Reliability and boundaries</p><h2>An algorithm is one part of the loop; it cannot take over the entire field system.</h2><ul class="reliability-list"><li><strong>Multi-source adaptation</strong><span>Industrial cameras, RTSP, raw streams and device protocols enter through explicit acquisition and parsing paths.</span></li><li><strong>Asynchronous isolation</strong><span>Inference returns through threads and signals, so UI, acquisition, inference and writing do not compete on one blocking path.</span></li><li><strong>Recording governance</strong><span>Snapshots, multi-source recording, raw writing, bounded queues and batch flushes address I/O pressure.</span></li><li><strong>Device loop</strong><span>Discovery, register access, PTZ, TEC and parameter delivery remain inside the control plane; this page exposes no address, session or control parameter.</span></li></ul></section>
          <section id="evidence" class="detail-section evidence-section"><p class="section-label">07 / Evidence</p><h2>The evidence is the end-to-end path, not one algorithm screenshot removed from context.</h2><div class="evidence-ledger"><article><span>Multi-source input</span><p>The engineering work includes RTSP, raw-frame recovery, camera discovery, packet reception and frame assembly.</p></article><article><span>Processing and deployment</span><p>It includes 16-bit infrared processing, ViBe background modelling, ONNX Runtime YOLOv8 and MNN inference paths.</p></article><article><span>Desktop engineering</span><p>It includes Qt UI, threads, signals and slots, recording, snapshots, raw-data writing, device control and CMake organization.</p></article></div></section>
          <section id="review" class="detail-section review-section"><p class="section-label">08 / Review and next step</p><p>This project sharpened a simple lesson: a vision algorithm has field value only when acquisition, concurrency, I/O, UI and device control can carry it. A next step is to add de-identified replayable scenarios and test conditions for comparing inputs, parameters and deployment paths.</p><div class="detail-end-actions"><a href={sitePath('/en/projects/freight-decision-agent')}>Previous: Freight decision <span aria-hidden="true">←</span></a><a href={sitePath('/en#projects')}>Back to projects <span aria-hidden="true">↑</span></a></div></section>
        </article>
      </div>
    </main>
    <script>
    import { onPageLoad } from '../../../lib/page-lifecycle';
    onPageLoad((signal) => {
      if(document.documentElement.lang.startsWith('en') !== true) return;
      const processStates = {
        raw: { index: 'Stage 01', title: 'Recover 16-bit infrared information from the raw stream.', input: 'Raw RTSP stream or industrial-camera frames.', goal: 'Parse frame structure and retain intensity information for both display and algorithms.', output: '16-bit infrared image data for later stages.', constraint: 'Do not mistake a display-oriented image for the algorithm input.', graphic: 'Preserve raw intensity levels' },
        normalize: { index: 'Stage 02', title: 'Turn a wide dynamic range into a comparable working view.', input: 'Recovered 16-bit infrared image data.', goal: 'Use dynamic-range handling and percentile clipping to manage extremes for a more stable display and processing range.', output: 'A normalized processing image.', constraint: 'Normalization supports inspection and processing; it does not overwrite the preserved raw path.', graphic: 'Converge the display and working range' },
        background: { index: 'Stage 03', title: 'Separate persistent change from transient disturbance with background modelling.', input: 'Normalized processing imagery.', goal: 'Use a ViBe background model as a controlled, updateable reference for later difference analysis.', output: 'Background reference and foreground-difference information.', constraint: 'The background is not a fixed template; it has to update with the scene under control.', graphic: 'Build an updateable reference background' },
        candidate: { index: 'Stage 04', title: 'Organize difference signals into inspectable candidate information.', input: 'Background differences and image-processing output.', goal: 'Use thresholding and morphology to reduce scattered noise before later modules consume candidate information.', output: 'Candidate-region information for later modules.', constraint: 'A candidate is an intermediate state, not a confirmed detection conclusion.', graphic: 'Organize inspectable candidate information' },
        inference: { index: 'Stage 05', title: 'Place deployed models on an independent asynchronous inference path.', input: 'Processed imagery or candidate information.', goal: 'Run ONNX Runtime or MNN inference and return structured feedback to the desktop application.', output: 'Structured inference feedback.', constraint: 'Inference must not block UI, acquisition or recording threads.', graphic: 'Complete inference on an independent path' },
        alert: { index: 'Stage 06', title: 'Return processing feedback to a controlled desktop loop.', input: 'Structured feedback from processing and inference.', goal: 'Organize display, recording, snapshots and device control into traceable engineering actions.', output: 'Desktop state and controlled feedback.', constraint: 'No device address, session, control instruction or real field alert is shown here.', graphic: 'Return to UI, recording and device control' },
      };
      const controls = document.querySelectorAll('[data-process]'); const stage = document.querySelector('[data-processing-stage]'); const index = document.querySelector('[data-process-index]'); const title = document.querySelector('[data-process-title]'); const input = document.querySelector('[data-process-input]'); const goal = document.querySelector('[data-process-goal]'); const output = document.querySelector('[data-process-output]'); const constraint = document.querySelector('[data-process-constraint]'); const graphic = document.querySelector('[data-process-graphic]');
      function selectProcess(key) { const state = processStates[key]; stage.dataset.processingStage = key; index.textContent = state.index; title.textContent = state.title; input.textContent = state.input; goal.textContent = state.goal; output.textContent = state.output; constraint.textContent = state.constraint; graphic.textContent = state.graphic; controls.forEach((control) => { const selected = control.dataset.process === key; control.classList.toggle('is-active', selected); control.setAttribute('aria-pressed', String(selected)); }); }
      controls.forEach((control) => control.addEventListener('click', () => selectProcess(control.dataset.process)));

    });
  </script>
  </body>
</html>
