---
import { ClientRouter } from 'astro:transitions';
import ThemeScript from '../../../components/ThemeScript.astro';
import ProjectVideo from '../../../components/ProjectVideo.astro';
import { sitePath } from '../../../lib/paths';
import SiteNav from '../../../components/SiteNav.astro';
import '../../../styles/home.css';
import '../../../styles/project-detail.css';
import '../../../styles/freight-detail.css';

const chapters = [
  ['Problem', 'problem'], ['Role', 'role'], ['Architecture', 'architecture'], ['Sandbox', 'sandbox'],
  ['Decisions', 'decisions'], ['Boundaries', 'reliability'], ['Evidence', 'evidence'], ['Review', 'review'],
];
const workflow = [
  ['01', 'Global State Restoration', 'Load the driver’s spatio-temporal state, monthly net-return progress, and active hard commitments instead of treating each search as stateless matching.'],
  ['02', 'NL Constraint Compilation', 'Compile natural-language route preferences, no-go zones, home deadlines, mandatory rest, and familiar-cargo bias into hard filter gates and soft penalties.'],
  ['03', 'Daily Temporal Rollout', 'Embed candidate moves into the remaining day window and downstream commitments to detect whether a choice locks out future options.'],
  ['04', 'Multi-Factor Opportunity Scoring', 'Jointly evaluate net profit, hourly yield, deadhead loss, transit duration, destination reload density, preference violation risk, and expiry probability.'],
  ['05', 'Bounded Selective Arbitration', 'Wake the LLM to arbitrate strictly within verified candidates only when top scores tie, soft commitments clash, or destination opportunity is ambiguous.'],
  ['06', 'Action Guard & Decay Memory', 'Enforce whitelist and parameter contracts at the action exit; write winning patterns, failed bids, and regional supply signals back into time-decayed Memory.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f6f5f1" />
    <ThemeScript />
    <ClientRouter fallback="swap" />
    <meta name="description" content="Freight Decision Agent: escaping greedy single-order traps with a deterministic constraint engine and selective LLM arbitration for optimal monthly net return." />
    <title>Freight Decision Agent · IT-coder-Yy</title>
  </head>
  <body>
    <a class="skip-link" href="#detail-content">Skip to project details</a>
    <SiteNav locale="en" pathname="/en/projects/freight-decision-agent" detail />
    <main id="detail-content" class="project-detail freight-detail">
      <section class="detail-hero freight-detail-hero" aria-labelledby="project-title">
        <div class="detail-hero-copy">
          <p class="detail-index">Project 02 / AI Agent</p>
          <h1 id="project-title">Freight <em>Decision</em> Agent</h1>
          <p class="detail-lede">Escaping the greedy single-order trap: a high-paying load can hide deadhead traps or break a promise to get home. Instead of letting an LLM blindly take over, this hybrid system locks down safety boundaries with a deterministic constraint engine and wakes the model only for genuine dilemmas—optimizing monthly net return across accepting, waiting, and repositioning.</p>
          <div class="detail-actions"><a class="detail-primary" href="#sandbox">Open decision sandbox <span aria-hidden="true">↓</span></a><a class="detail-quiet" href={sitePath('/en#projects')}>Back to projects <span aria-hidden="true">↑</span></a></div>
          <dl class="project-facts"><div><dt>Project type</dt><dd>Core Agent architecture project</dd></div><div><dt>My role</dt><dd>Constraint compiler, opportunity-cost scorer & LLM action guard</dd></div><div><dt>Focus</dt><dd>Hybrid Agent · Constraint Compiler · Memory · Guard</dd></div></dl>
        </div>
        <figure class="freight-hero-board" aria-labelledby="freight-board-caption">
          <div class="freight-board-column"><p>Continuous context</p><strong>Monthly state machine</strong><span>Home deadlines · Rest rules · Familiar cargo · Obligations</span></div>
          <div class="freight-board-column freight-board-core"><p>Deterministic backbone</p><strong>Compiler / Planner / Scoring</strong><span>Hard gates veto first; multi-factor models weigh opportunity cost</span></div>
          <div class="freight-board-column"><p>Guarded action exit</p><strong>Accept / Wait / Reposition</strong><span>Action whitelist + parameter contract validation</span></div>
          <figcaption id="freight-board-caption">Deterministic rules lead the pipeline; the LLM is woken selectively only when multi-factor returns tie or soft constraints collide.</figcaption>
        </figure>
      </section>

      <section class="detail-film" aria-label="Project film">
        <ProjectVideo kind="freight" locale="en" />
      </section>

      <div class="detail-body">
        <aside class="chapter-rail" aria-label="On-page sections"><p>Reading path</p><ol>{chapters.map(([label, id]) => <li><a href={'#' + id}>{label}</a></li>)}</ol></aside>
        <article class="detail-article">
          <section id="problem" class="detail-section"><p class="section-label">01 / Context</p><h2>Escaping the Greedy Single-Order Trap</h2><p class="section-subhead">— Why sequential freight decisions cannot rely on single-order greed or unconstrained LLM calls.</p><p>Every move a freight driver makes—accepting a load, waiting on-site, or deadheading to a new hub—reshapes future location, remaining driving hours, and home-time windows. Greedily grabbing the highest sticker price often strands drivers in low-demand dead ends, while handing every step to an end-to-end LLM inflates latency and token cost while risking hard safety or home-commitment violations. This project pairs a deterministic constraint backbone with selective LLM arbitration: code enforces hard boundaries, and model reasoning is reserved strictly for gray-zone tradeoffs.</p></section>
          <section id="role" class="detail-section"><p class="section-label">02 / My role</p><div class="role-grid"><article><span>Constraint compilation & temporal planning</span><p>Built the compiler that translates natural-language preferences into executable hard gates and soft penalties, projecting daily moves against monthly targets and future obligations.</p></article><article><span>Multi-factor scoring & decay memory</span><p>Engineered the candidate evaluator accounting for deadhead loss and destination reload potential, backed by a time-decayed Memory loop for winning patterns, failed bids, and market signals.</p></article><article><span>Selective arbitration & action guard</span><p>Implemented the rule-first, wake-on-demand LLM policy paired with strict action-whitelist and parameter-contract verification at the execution exit.</p></article></div></section>
          <section id="architecture" class="detail-section architecture-section"><p class="section-label">03 / Controlled hybrid architecture</p><h2>Deterministic Rules First, Selective LLM Arbitration</h2><p class="section-subhead">— Rules lock down the safety floor; the model wakes only for razor-thin strategic tradeoffs.</p><p class="architecture-note">Below is the six-stage hybrid pipeline executed at each decision tick. Deterministic computation handles over 80% of filtering and quantitative scoring, ensuring every LLM call targets a high-leverage strategic dilemma.</p><ol class="workflow">{workflow.map(([index, title, description]) => <li><span>{index}</span><div><strong>{title}</strong><p>{description}</p></div></li>)}</ol><div class="architecture-footnote freight-footnote"><span>Deterministic core</span><i></i><span>Constraint compiler / Day planner / Candidate scoring engine</span><span>Adaptive policy layer</span><i></i><span>Decay memory store / Selective LLM arbitrator / Action guard</span></div></section>
          <section id="sandbox" class="detail-section sandbox-section">
            <p class="section-label">04 / Manual decision sandbox</p><h2>Interactive Tri-State Decision Sandbox</h2><p class="section-subhead">— Toggle candidate actions to inspect how hard rule gates, multi-factor scoring, and LLM arbitration collaborate.</p><p>Click or use the keyboard to toggle between the three core action primitives and observe how the deterministic rule gate, multi-factor scorer, and selective LLM arbitrator collaborate.</p>
            <div class="sandbox-shell">
              <div class="sandbox-context" aria-label="Fixed driver constraints"><p>Active driver constraints</p><ul><li>Hard home-time window active</li><li>Mandatory rest buffer required</li><li>Familiar-cargo route preference</li></ul></div>
              <div class="sandbox-stage" aria-live="polite"><p class="sandbox-stage-label">Decision path</p><div class="sandbox-lanes"><section><p>Rule gate</p><strong data-sandbox-gate>Time window, home deadline, and no-go zones all pass hard gates</strong></section><section><p>Candidate comparison</p><strong data-sandbox-candidate>Candidate A leads decisively in net yield and familiar-cargo bonus</strong></section><section><p>Model arbitration</p><strong data-sandbox-model>Score margin exceeds threshold: rules lock decision with zero LLM cost</strong></section></div><div class="sandbox-outcome"><p data-sandbox-title>Accept: when hard constraints pass and the margin is clear, the deterministic path locks it in milliseconds.</p><ul data-sandbox-list><li>Evaluates true net yield after deducting deadhead cost and destination opportunity loss.</li><li>Action Guard verifies order ID and time-window contracts before execution.</li></ul><strong data-sandbox-action>Executed action: Accept load (Accept)</strong></div></div>
              <div class="sandbox-controls" role="group" aria-label="Choose a decision action"><p>Choose action</p><button type="button" class="is-active" data-decision="accept" aria-pressed="true">Accept</button><button type="button" data-decision="wait" aria-pressed="false">Wait</button><button type="button" data-decision="reposition" aria-pressed="false">Reposition</button></div>
              <p class="sandbox-note">The sandbox illustrates internal state transitions and arbitration triggers across three representative decision regimes.</p>
            </div>
          </section>
          <section id="decisions" class="detail-section"><p class="section-label">05 / Key decisions</p><div class="decision-list"><article><p>Decision one</p><h3>Deterministic Backbone with Selective Arbitration</h3><dl><div><dt>Problem</dt><dd>Querying an LLM at every decision tick inflates latency and token spend while exposing long-horizon plans to hallucinated, rule-breaking moves.</dd></div><div><dt>Choice</dt><dd>The constraint compiler, daily planner, and multi-factor scorer handle all hard filtering and baseline ranking; the LLM wakes only when top candidates tie, soft commitments clash, or regional opportunity is ambiguous.</dd></div><div><dt>Boundary</dt><dd>The model arbitrates strictly within the pre-vetted feasible candidate subset, and its output must pass post-arbitration Action Guard validation.</dd></div></dl></article><article><p>Decision two</p><h3>Monthly Net-Yield & Opportunity-Cost Modeling</h3><dl><div><dt>Problem</dt><dd>The highest-grossing single load often entails long deadhead pickup, a dead-end destination with no reload, or a broken home/rest commitment.</dd></div><div><dt>Choice</dt><dd>The scoring engine decomposes gross rate into net profit, hourly yield, deadhead loss, transit duration, destination reload opportunity cost, preference penalty, and expiry risk.</dd></div><div><dt>Boundary</dt><dd>Quantitative scores provide an explainable baseline ranking while preserving soft-penalty elasticity for context-aware arbitration in edge markets.</dd></div></dl></article><article><p>Decision three</p><h3>Time-Decayed Memory for Policy Steering</h3><dl><div><dt>Problem</dt><dd>Freight markets exhibit strong spatio-temporal periodicity; without memory, an agent repeatedly falls into the same deadhead traps or failed bids.</dd></div><div><dt>Choice</dt><dd>Engineered a layered MemoryStore that captures winning route patterns, regional supply windows, failure reflections, and active plans—injected into subsequent decision ticks with time-decay weights.</dd></div><div><dt>Boundary</dt><dd>Memory retrieval filters by both spatial relevance and recency decay, ensuring high-signal operational feedback directly informs candidate scoring and arbitration prompts.</dd></div></dl></article></div></section>
          <section id="reliability" class="detail-section"><p class="section-label">06 / Reliability and boundaries</p><h2>Multi-Layer Guards at the Action Exit</h2><p class="section-subhead">— Compiler-level constraints and whitelisted primitives ensure every decision is verifiable and reversible.</p><ul class="reliability-list"><li><strong>Action-space whitelist (Action Guard)</strong><span>The execution exit accepts only predefined primitives—Accept, Wait, and Reposition—preventing the model from inventing unauthorized operational commands.</span></li><li><strong>Parameter-level contract verification</strong><span>Even after LLM arbitration, target order IDs, destination hubs, and time windows are re-validated against the feasible candidate set and hard constraints, falling back to the top deterministic choice on any violation.</span></li><li><strong>Pre-emptive hard-commitment locking</strong><span>Home deadlines, mandatory rest buffers, no-go zones, and temporary obligations are compiled into non-negotiable filter gates before scoring or model invocation ever begins.</span></li><li><strong>Replayable decision audit trail</strong><span>Every decision tick logs active constraints, candidate score breakdowns, arbitration triggers, and final guard verdicts for 100% end-to-end traceability.</span></li></ul></section>
          <section id="evidence" class="detail-section evidence-section"><p class="section-label">07 / Evidence</p><h2>Verifiable Modules & Boundary Test Suites</h2><p class="section-subhead">— Orthogonal six-layer engine architecture backed by comprehensive unit tests and an interactive sandbox.</p><div class="evidence-ledger"><article><span>Cohesive six-layer architecture</span><p>Cleanly decouples the Constraint Compiler, Day Planner, Candidate Scoring Engine, Decay MemoryStore, Policy Coordinator, and Selective LLM Decision Service.</p></article><article><span>Comprehensive unit & boundary tests</span><p>Automated test suites verify NL preference compilation, memory time-decay, familiar-cargo weighting, rest/home hard vetoes, score-margin arbitration triggers, and illegal-action fallbacks.</p></article><article><span>Interactive qualitative sandbox</span><p>The on-page state machine transparently demonstrates how hard rule gates, multi-factor scoring, selective LLM arbitration, and exit guards collaborate.</p></article></div></section>
          <section id="review" class="detail-section review-section"><p class="section-label">08 / Review and next step</p><p>The core insight behind Freight Decision Agent is that for long-horizon, high-stakes sequential decisions, the strongest architecture is not "hand everything to an LLM," but "lock down the floor with deterministic engineering and raise the ceiling with selective model reasoning." Next steps focus on building a multi-month market simulator and an offline policy benchmark to run ablation studies comparing pure rules, pure LLMs, and this hybrid architecture across monthly net yield and commitment fulfillment rate.</p><div class="detail-end-actions"><a href={sitePath('/en#projects')}>Back to projects <span aria-hidden="true">↑</span></a><a href="#sandbox">Back to sandbox <span aria-hidden="true">↑</span></a></div></section>
        </article>
      </div>
    </main>
    <script>
    import { onPageLoad } from '../../../lib/page-lifecycle';
    onPageLoad((signal) => {
      if(document.documentElement.lang.startsWith('en') !== true) return;
      const decisions = {
        accept: { gate: 'Time window, home deadline, and no-go zones all pass hard gates', candidate: 'Candidate A leads decisively in net yield and familiar-cargo bonus', model: 'Score margin exceeds threshold: rules lock decision with zero LLM cost', title: 'Accept: when hard constraints pass and the margin is clear, the deterministic path locks it in milliseconds.', notes: ['Evaluates true net yield after deducting deadhead cost and destination opportunity loss.', 'Action Guard verifies order ID and time-window contracts before execution.'], action: 'Executed action: Accept load (Accept)' },
        wait: { gate: 'Available loads violate home deadline or fatigue limits—vetoed by hard gates', candidate: 'Feasible candidate set is empty; waiting on-site preserves today’s rest buffer', model: 'Zero competing candidates: rules retain Wait and bypass redundant LLM calls', title: 'Wait: when live loads breach safety or commitment boundaries, holding position is the optimal controlled move.', notes: ['Mandatory rest and home-time windows remain strictly protected in the daily plan.', 'Waiting attaches a re-evaluation timer that triggers a fresh rollout as market loads refresh.'], action: 'Executed action: Controlled wait (Wait)' },
        reposition: { gate: 'Target hub satisfies no-go zones, homeward direction, and remaining hours', candidate: 'Local demand is dry; two candidate hubs tie closely in expected net yield', model: 'Destination opportunity is ambiguous: LLM wakes to arbitrate using historical memory', title: 'Reposition: invest controlled deadhead cost now to capture a high-density reload window.', notes: ['Deadhead distance and fuel burn are deducted directly from the monthly net-return ledger.', 'The LLM may only select among pre-vetted safe hubs and must emit structured justification.'], action: 'Executed action: Reposition to high-potential hub (Reposition)' },
      };
      const controls = document.querySelectorAll('[data-decision]');
      const gate = document.querySelector('[data-sandbox-gate]'); const candidate = document.querySelector('[data-sandbox-candidate]'); const model = document.querySelector('[data-sandbox-model]'); const title = document.querySelector('[data-sandbox-title]'); const notes = document.querySelector('[data-sandbox-list]'); const action = document.querySelector('[data-sandbox-action]');
      function selectDecision(key) { const decision = decisions[key]; gate.textContent = decision.gate; candidate.textContent = decision.candidate; model.textContent = decision.model; title.textContent = decision.title; action.textContent = decision.action; notes.replaceChildren(...decision.notes.map((note) => { const item = document.createElement('li'); item.textContent = note; return item; })); controls.forEach((control) => { const selected = control.dataset.decision === key; control.classList.toggle('is-active', selected); control.setAttribute('aria-pressed', String(selected)); }); }
      controls.forEach((control) => control.addEventListener('click', () => selectDecision(control.dataset.decision)));

    });
  </script>
  </body>
</html>
