---
import SiteNav from '../../components/SiteNav.astro';
import SeoHead from '../../components/SeoHead.astro';
import BlogSearch from '../../components/blog/BlogSearch.astro';
import PostList from '../../components/blog/PostList.astro';
import { BLOG_CATEGORIES } from '../../lib/blog-meta';
import { getBlogPosts } from '../../lib/blog';
import '../../styles/home.css';
import '../../styles/blog.css';

const posts = await getBlogPosts();
const categories = BLOG_CATEGORIES;
const featuredCount = posts.filter((post) => post.data.featured).length;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title="技术博客｜于洋"
      description="于洋的中文技术博客，系统记录 AI Agent、红外视觉、C++ 与 Qt、多模型部署等可复现的工程实践。"
      canonicalPath="/blog"
    />
  </head>
  <body class="blog-page blog-index-page">
    <a class="skip-link" href="#blog-content">跳至正文</a>
    <SiteNav locale="zh" pathname="/blog" showLanguageSwitch={false} />

    <main id="blog-content">
      <header class="blog-hero">
        <div class="blog-hero-index" aria-hidden="true">
          <span>FIELD NOTES</span>
          <strong>{String(posts.length).padStart(2, '0')}</strong>
        </div>
        <div class="blog-hero-copy">
          <p>技术笔记 / Engineering Notes</p>
          <h1>记录学过的原理、<br />做过的工程，<br /><em>以及真正踩过的坑。</em></h1>
          <p class="blog-hero-description">
            围绕 AI Agent、红外视觉、C++ / Qt、模型部署与论文阅读，记录问题边界、实现路径、失败模式和验证方法。
          </p>
        </div>
        <dl class="blog-ledger">
          <div><dt>已发布</dt><dd>{posts.length}</dd></div>
          <div><dt>精选</dt><dd>{featuredCount}</dd></div>
          <div><dt>主题域</dt><dd>{categories.length}</dd></div>
        </dl>
      </header>

      <section class="blog-index" aria-labelledby="article-index-title">
        <div class="blog-index-heading">
          <p>Article Index / 文章索引</p>
          <h2 id="article-index-title">从问题出发，<br />按证据归档。</h2>
          <p>先搜索，再阅读。每篇文章都给出适用边界、关键代码、验证清单和可追溯来源。</p>
        </div>
        <div class="blog-index-content">
          <BlogSearch categories={categories} postCount={posts.length} />
          <PostList posts={posts} />
        </div>
      </section>
    </main>

    <footer class="blog-footer">
      <p>持续记录可复现、可解释、可维护的工程实践。</p>
      <div>
        <span>Yu Yang / 2026</span>
        <a href="mailto:yuyang24@mails.ucas.ac.cn">yuyang24@mails.ucas.ac.cn</a>
      </div>
    </footer>
  </body>
</html>
