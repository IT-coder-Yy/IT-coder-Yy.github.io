---
import { ClientRouter } from 'astro:transitions';
import ThemeScript from '../../components/ThemeScript.astro';
import SiteNav from '../../components/SiteNav.astro';
import SeoHead from '../../components/SeoHead.astro';
import BlogSearch from '../../components/blog/BlogSearch.astro';
import PostList from '../../components/blog/PostList.astro';
import { BLOG_CATEGORIES } from '../../lib/blog-meta';
import { getBlogPosts } from '../../lib/blog';
import '../../styles/home.css';
import '../../styles/blog.css';

const posts = await getBlogPosts();
const categories = BLOG_CATEGORIES;
const featuredCount = posts.filter((post) => post.data.featured).length;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead
      title="技术博客｜IT-coder-Yy"
      description="IT-coder-Yy 的中文技术博客，系统记录 AI Agent、红外视觉、C++ 与 Qt、多模型部署等可复现的工程实践。"
      canonicalPath="/blog"
    />
    <ThemeScript />
    <ClientRouter fallback="swap" />
  </head>
  <body class="blog-page blog-index-page">
    <a class="skip-link" href="#blog-content">跳至正文</a>
    <SiteNav locale="zh" pathname="/blog" showLanguageSwitch={false} />

    <main id="blog-content">
      <header class="blog-hero">
        <div class="blog-hero-copy">
          <p class="blog-hero-badge">技术笔记 · ENGINEERING NOTES</p>
          <h1>记录学过的原理、做过的工程与<em>真实踩坑</em></h1>
          <p class="blog-hero-description">
            围绕 AI Agent、红外视觉、C++ / Qt、模型部署与论文阅读，系统沉淀问题边界、实现路径、失败模式与可复现验证。
          </p>
        </div>
        <dl class="blog-ledger">
          <div><dt>已发布文章</dt><dd>{posts.length} 篇</dd></div>
          <div><dt>精选深度长文</dt><dd>{featuredCount} 篇</dd></div>
          <div><dt>核心技术域</dt><dd>{categories.length} 个</dd></div>
        </dl>
      </header>

      <section class="blog-index" aria-labelledby="article-index-title">
        <div class="blog-index-heading">
          <p>Article Index / 文章索引</p>
          <h2 id="article-index-title">从问题出发，按证据归档</h2>
          <p class="blog-index-subhead">—— 每篇手记均包含适用边界、核心实现与验证清单。</p>
          <p>先搜索，再阅读。每篇文章都给出适用边界、关键代码、验证清单和可追溯来源。</p>
        </div>
        <div class="blog-index-content">
          <BlogSearch categories={categories} postCount={posts.length} />
          <PostList posts={posts} />
        </div>
      </section>
    </main>

    <footer class="blog-footer">
      <p>持续记录可复现、可解释、可维护的工程实践。</p>
      <div>
        <span>IT-coder-Yy / 2026</span>
        <a href="mailto:coder.yy521@gmail.com">coder.yy521@gmail.com</a>
      </div>
    </footer>
  </body>
</html>
